;;; lispm-office-animation-test.el --- Bounded animation work -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'lispm-office-test
         (expand-file-name "lispm-office-test.el"
                           (file-name-directory (or load-file-name buffer-file-name))))

(ert-deftest lispm-office-animation-reuses-six-images-and-keeps-geometry ()
  (lispm-office-test--isolated
    (setf (plist-get (car records) :status) '(:state working))
    (let ((office (lispm-office))
          (renders 0) (fits 0) (menus 0)
          (render (symbol-function 'lispm-office-render-svg))
          (fit (symbol-function 'lispm-office--fit-scale))
          (menu (symbol-function 'lispm-office--insert-view-menu)))
      (with-current-buffer office
        (lispm-office-test--graphical
          (cl-letf (((symbol-function 'input-pending-p) (lambda (&rest _) nil))
                    ((symbol-function 'lispm-office--dimensions) (lambda () '(1000 . 650)))
                    ((symbol-function 'lispm-office-render-svg)
                     (lambda (&rest args) (cl-incf renders) (apply render args)))
                    ((symbol-function 'lispm-office--fit-scale)
                     (lambda () (cl-incf fits) (funcall fit)))
                    ((symbol-function 'lispm-office--insert-view-menu)
                     (lambda () (cl-incf menus) (funcall menu))))
            (lispm-office--draw)
            (let ((plan (lispm-office--scene-plan))
                  (text (buffer-substring-no-properties (point-min) (point-max)))
                  (reads roster-reads))
              (dotimes (_ 40) (lispm-office--tick office))
              (should (= renders 6))
              (should (= (length lispm-office--frame-images) 6))
              (should (= fits 1))
              (should (= menus 1))
              (should (eq plan (lispm-office--scene-plan)))
              (should (equal text (buffer-substring-no-properties (point-min) (point-max))))
              (should (= reads roster-reads))
              (should-not detail-reads))))))))

(ert-deftest lispm-office-animation-invalidates-images-on-scene-changes ()
  (lispm-office-test--isolated
    (setf (plist-get (car records) :status) '(:state working))
    (let ((office (lispm-office)) (size '(1000 . 650)))
      (with-current-buffer office
        (lispm-office-test--graphical
          (cl-letf (((symbol-function 'input-pending-p) (lambda (&rest _) nil))
                    ((symbol-function 'lispm-office--dimensions) (lambda () size)))
            (lispm-office--draw)
            (dolist (change '(roster selection palette resize))
              (let ((images lispm-office--frame-images))
                (pcase change
                  ('roster
                   (setf (plist-get (cadr records) :status) '(:state blocked))
                   (lispm-office--ingest records))
                  ('selection (lispm-office--select '(codex "b")))
                  ('palette (lispm-office--palette-changed))
                  ('resize (setq size '(900 . 600)) (lispm-office--tick office)))
                (should (vectorp lispm-office--frame-images))
                (should-not (eq images lispm-office--frame-images))
                (should (= 1 (seq-count #'identity lispm-office--frame-images)))))))))))

(ert-deftest lispm-office-animation-does-not-cache-time-dependent-positions ()
  (with-temp-buffer
    (let* ((first (list :key '(lispm "a") :waits-on nil))
           (second (list :key '(lispm "b")))
           (lispm-office--plan (list :nodes (list first second)))
           (lispm-office--phase 0)
           (renders 0))
      (cl-letf (((symbol-function 'lispm-office-render-svg)
                 (lambda (&rest _) (cl-incf renders)))
                ((symbol-function 'lispm-office-render-visible-events)
                 (lambda (_plan _scale _room events) events))
                ((symbol-function 'lispm-ui-svg-image) #'identity))
        (should (= (lispm-office--floor-image) (lispm-office--floor-image)))
        (should (= renders 1))
        (setf (plist-get first :waits-on) '((lispm "offscreen")))
        (should (= (lispm-office--floor-image) (lispm-office--floor-image)))
        (should (= renders 1))
        (setf (plist-get first :waits-on) '((lispm "b")))
        (should-not (= (lispm-office--floor-image) (lispm-office--floor-image)))
        (should-not lispm-office--frame-images)
        (setf (plist-get first :waits-on) nil)
        (setq lispm-office--flights (list (list :started (float-time))))
        (should-not (= (lispm-office--floor-image) (lispm-office--floor-image)))
        (should-not lispm-office--frame-images)
        (setq lispm-office--flights nil)
        (should (= (lispm-office--floor-image) (lispm-office--floor-image)))
        (should (= renders 6))))))

(ert-deftest lispm-office-animation-schedules-after-drawing-and-yields-to-input ()
  (with-temp-buffer
    (let ((lispm-office-frame-interval 0.12)
          (pending t) (draws 0) (scheduled nil) (cancelled nil))
      (cl-letf (((symbol-function 'lispm-office--animated-p) (lambda () t))
                ((symbol-function 'lispm-office--graphic-p) (lambda () t))
                ((symbol-function 'input-pending-p) (lambda (&rest _) pending))
                ((symbol-function 'run-at-time)
                 (lambda (delay repeat function buffer)
                   (should (null repeat))
                   (should (eq function #'lispm-office--tick))
                   (should (eq buffer (current-buffer)))
                   (push (list delay draws) scheduled)))
                ((symbol-function 'cancel-timer) (lambda (timer) (push timer cancelled)))
                ((symbol-function 'lispm-office--draw-frame)
                 (lambda ()
                   (should-not lispm-office--timer)
                   (cl-incf draws))))
        (lispm-office--sync-timer)
        (should (= (length scheduled) 1))
        (lispm-office--tick (current-buffer))
        (should (= draws 0))
        (should (= lispm-office--phase 0))
        (setq pending nil)
        (lispm-office--tick (current-buffer))
        (should (= draws 1))
        (should (= lispm-office--phase 1))
        (should (equal scheduled '((0.12 1) (0.12 0) (0.12 0))))
        (should (= (length cancelled) 2))))))

(ert-deftest lispm-office-animation-render-error-leaves-no-recurring-timer ()
  (with-temp-buffer
    (let ((lispm-office--timer (run-at-time 60 nil #'ignore)))
      (unwind-protect
          (cl-letf (((symbol-function 'lispm-office--graphic-p) (lambda () t))
                    ((symbol-function 'input-pending-p) (lambda (&rest _) nil))
                    ((symbol-function 'lispm-office--draw-frame)
                     (lambda () (error "Broken image"))))
            (let ((timer lispm-office--timer))
              (should-error (lispm-office--tick (current-buffer)))
              (should-not lispm-office--timer)
              (should-not (memq timer timer-list))))
        (when lispm-office--timer (cancel-timer lispm-office--timer))))))

(ert-deftest lispm-office-animation-does-not-interrupt-an-active-drawing ()
  (with-temp-buffer
    (let ((lispm-office--drawing t)
          (lispm-office-frame-interval 60))
      (unwind-protect
          (cl-letf (((symbol-function 'lispm-office--graphic-p) (lambda () t))
                    ((symbol-function 'lispm-office--animated-p) (lambda () t))
                    ((symbol-function 'lispm-office--floor-image)
                     (lambda () (ert-fail "Nested floor rendering"))))
            (lispm-office--draw-frame)
            (lispm-office--tick (current-buffer))
            (should (= lispm-office--phase 0))
            (should (timerp lispm-office--timer))
            (should-not (timer--repeat-delay lispm-office--timer))
            (should (memq lispm-office--timer timer-list)))
        (when lispm-office--timer (cancel-timer lispm-office--timer))))))

(provide 'lispm-office-animation-test)
;;; lispm-office-animation-test.el ends here
