(ert-deftest lispm-office-plugin-hidden-inline-page-defers-context-follow ()
  (lispm-office-plugin-test--isolated
    (let ((lispm-office-follow-current-agent t))
      (switch-to-buffer chat)
      (lispm-office-plugin-mode 1)
      (let* ((office (lispm-office))
             (inspector (lispm-office-inspect key 'mailbox office))
             (conversation-window (get-buffer-window inspector)))
        (select-window conversation-window)
        (switch-to-buffer other-source)
        (cl-letf (((symbol-function 'lispm-agents-roster-details)
                   (lambda (&rest _) (ert-fail "Hidden inspector eagerly read details"))))
          (run-hook-with-args 'window-buffer-change-functions (selected-frame)))
        (should (eq (selected-window) conversation-window))
        (should-not (get-buffer-window inspector))
        ;; Details share the Work buffer, so replacing its sole window hides
        ;; the whole page.  A hidden page retains its session without reads.
        (should (equal (buffer-local-value 'lispm-office-inspect--key inspector) key))
        (should (eq (buffer-local-value 'lispm-office-inspect--tab inspector) 'mailbox))
        (should-not (buffer-local-value 'lispm-office-inspect--dirty inspector))
        ;; Once the page is visible beside the selected conversation, the
        ;; same public window event follows it and refreshes the active tab.
        (let ((work-window (split-window conversation-window nil 'right)))
          (set-window-buffer work-window office)
          (run-hook-with-args 'window-buffer-change-functions (selected-frame))
          (should (equal (buffer-local-value 'lispm-office-inspect--key inspector) other-key))
          (should (eq (buffer-local-value 'lispm-office-inspect--tab inspector) 'mailbox)))))))

(ert-deftest lispm-office-plugin-manual-selection-survives-same-source-updates ()
  (lispm-office-plugin-test--isolated
    (let ((lispm-office-follow-current-agent t))
      (switch-to-buffer chat)
      (lispm-office-plugin-mode 1)
      (lispm-office-toggle)
      (let ((office (get-buffer "*LispM Office*")))
        (with-current-buffer office
          ;; The manual-selection invariant applies after explicitly widening
          ;; the view to include this otherwise unrelated conversation.
          (lispm-office-project)
          (lispm-office--select other-key))
        (setf (lispm-agent-status agent) "A new status on the same conversation")
        (lispm-agents-roster-notify agent '(status))
        (lispm-agents-roster--flush)
        (should (equal (buffer-local-value 'lispm-office--selected office) other-key))
        (lispm-office-plugin-test--source-window chat)
        (lispm-office-plugin-test--selection-event)
        (should (equal (buffer-local-value 'lispm-office--selected office) other-key))))))

(ert-deftest lispm-office-plugin-disable-preserves-conversation-and-developer-preview ()
  (lispm-office-plugin-test--isolated
    (lispm-office-plugin-mode 1)
    (switch-to-buffer chat)
    (let* ((office (lispm-office))
           (inspector (lispm-office-inspect key 'work office))
           (preview (lispm-office-demo 2)))
      (lispm-office-plugin-mode -1)
      (should-not (buffer-live-p office))
      (should-not (buffer-live-p inspector))
      (should (buffer-live-p preview))
      (should (buffer-live-p source))
      (should (buffer-live-p chat))
      (should (eq (lispm-agent-buffer agent) source))
      (should-not lispm-agents-roster-change-functions)
      (dolist (buffer (list source chat other-source))
        (should-not (buffer-local-value 'lispm-office-agent-mode buffer))))))

(ert-deftest lispm-office-plugin-reenable-removes-only-owned-hooks ()
  (lispm-office-plugin-test--isolated
    (let ((sentinel (lambda (&rest _) nil))
          (hooks '(lispm-chat-mode-hook lispm-session-mode-hook
                   lispm-agents-sessions-changed-hook window-selection-change-functions
                   window-buffer-change-functions)))
      (dolist (hook hooks) (add-hook hook sentinel))
      (lispm-office-plugin-mode 1)
      (let ((enabled-hooks (mapcar (lambda (hook) (copy-sequence (symbol-value hook))) hooks)))
        (lispm-office-plugin-mode 1)
        (should (equal enabled-hooks (mapcar #'symbol-value hooks)))
        (lispm-office-plugin-mode -1)
        (dolist (hook hooks) (should (equal (symbol-value hook) (list sentinel))))
        (lispm-office-plugin-mode 1)
        (should (equal enabled-hooks (mapcar #'symbol-value hooks)))
        (should (buffer-local-value 'lispm-office-agent-mode chat))
        (should-not lispm-agents-roster-change-functions)))))

(ert-deftest lispm-office-plugin-unload-releases-resources-and-can-reload ()
  (lispm-office-plugin-test--isolated
    (let ((sentinel (lambda (&rest _) nil))
          (hooks '(lispm-chat-mode-hook lispm-session-mode-hook
                   lispm-agents-sessions-changed-hook window-selection-change-functions
                   window-buffer-change-functions)))
      (dolist (hook hooks) (add-hook hook sentinel))
      (switch-to-buffer chat)
      (lispm-office-plugin-mode 1)
      (let* ((conversation-window (selected-window))
             (office (lispm-office))
             (inspector (lispm-office-inspect key 'work office)))
        (unwind-protect
            (progn
              (should (fboundp 'lispm-office-plugin-unload-function))
              ;; Force bypasses this test file's require dependency, but
              ;; unloads the real feature through Emacs' lifecycle hook.
              (unload-feature 'lispm-office-plugin t)
              (should-not (featurep 'lispm-office-plugin))
              (should-not (buffer-live-p office))
              (should-not (buffer-live-p inspector))
              (should-not lispm-office--buffers)
              (should-not lispm-office-inspect--buffers)
              (should-not lispm-agents-roster-change-functions)
              (should-not lispm-agents-roster--timer)
              (dolist (hook hooks) (should (equal (symbol-value hook) (list sentinel))))
              (should (buffer-live-p source))
              (should (buffer-live-p chat))
              (should (window-live-p conversation-window))
              (should (eq (window-buffer conversation-window) chat))
              (should (eq (lispm-agent-buffer agent) source))
              (with-current-buffer chat
                (should-not (bound-and-true-p lispm-office-agent-mode))
                (should-not (eq (key-binding (kbd "C-c O")) #'lispm-office-toggle))))
          ;; Other tests and callers must retain a usable plugin even if
          ;; an assertion about unloading fails.
          (require 'lispm-office-plugin))
        (lispm-office-plugin-mode 1)
        (should (buffer-local-value 'lispm-office-agent-mode chat))
        (should-not lispm-agents-roster-change-functions)))))

