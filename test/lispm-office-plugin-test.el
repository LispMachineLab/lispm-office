(ert-deftest lispm-office-plugin-fresh-terminal-focus-resolves-on-roster-notification ()
  (lispm-office-plugin-test--isolated
    (let ((lispm-agents-defined '((claude :name "Claude" :program "claude")))
          (terminal (generate-new-buffer " *Office plugin fresh terminal*")))
      (with-current-buffer terminal
        (setq-local major-mode (car lispm-agents-terminal-modes)
                    lispm-agents-buffer-agent 'claude
                    default-directory (file-name-as-directory directory)))
      ;; Model terminal liveness without spawning a process.  Registry,
      ;; identity lookup, roster snapshots and notifications remain real.
      (cl-letf (((symbol-function 'lispm-agents-terminal-live-p)
                 (lambda (buffer) (eq buffer terminal))))
        (switch-to-buffer terminal)
        (lispm-office-plugin-mode 1)
        (lispm-office-toggle)
        (let ((office (get-buffer "*LispM Office*"))
              (terminal-key '(claude "new-terminal-identity")))
          (should-not (lispm-office--context-key terminal))
          (with-current-buffer office
            (should-not lispm-office--selected)
            (should-error (lispm-office--key) :type 'user-error)
            (should (string-match-p "Session is starting…" (buffer-string))))
          ;; Other agents can update while this terminal is still waiting
          ;; for its identity; none of them may become its action target.
          (lispm-agents-roster-notify agent '(status))
          (lispm-agents-roster--flush)
          (should-not (buffer-local-value 'lispm-office--selected office))
          (with-current-buffer terminal
            (setq-local lispm-agents-buffer-session-id (cadr terminal-key)))
          (lispm-agents-roster-notify terminal '(identity agents))
          (lispm-agents-roster--flush)
          (should (equal (buffer-local-value 'lispm-office--selected office) terminal-key))
          (should (buffer-local-value 'lispm-office--room office))
          (should (eq (window-buffer (selected-window)) office)))))))

(ert-deftest lispm-office-plugin-follow-unknown-source-clears-office-and-inspector-targets ()
  (lispm-office-plugin-test--isolated
    (let ((lispm-office-follow-current-agent t)
          (lispm-agents-defined '((claude :name "Claude" :program "claude")))
          (terminal (generate-new-buffer " *Office plugin pending terminal*")))
      (with-current-buffer terminal
        (setq-local major-mode (car lispm-agents-terminal-modes)
                    lispm-agents-buffer-agent 'claude
                    default-directory (file-name-as-directory directory)))
      (cl-letf (((symbol-function 'lispm-agents-terminal-live-p)
                 (lambda (buffer) (eq buffer terminal))))
        (switch-to-buffer chat)
        (lispm-office-plugin-mode 1)
        (let* ((office (lispm-office))
               (inspector (lispm-office-inspect key 'mailbox office))
               (conversation-window (split-window (get-buffer-window office) nil 'right))
               (terminal-key '(claude "resolved-terminal-identity")))
          (select-window conversation-window)
          (switch-to-buffer terminal)
          (cl-letf (((symbol-function 'lispm-agents-roster-details)
                     (lambda (&rest _) (ert-fail "Pending inspector read another agent's details"))))
            (run-hook-with-args 'window-buffer-change-functions (selected-frame))
            (with-current-buffer inspector
              ;; Batch frames defer paint; exercise that pending paint too.
              (lispm-office-inspect--draw)
              (should-not lispm-office-inspect--key)
              (should (eq lispm-office-inspect--tab 'mailbox))
              (should (string-match-p "[Ww]aiting.*session\\|session identity" (buffer-string)))
              (let ((back (next-button (point-min))))
                (should back)
                (should (string-match-p "Back" (button-get back 'lispm-ui-label)))
                (should-not (next-button (button-end back))))
              (should-error (lispm-office-inspect-compose) :type 'user-error))
            (with-current-buffer office
              (should-not lispm-office--selected)
              (should-error (lispm-office--key) :type 'user-error)))
          (should (eq (selected-window) conversation-window))
          (with-current-buffer terminal
            (setq-local lispm-agents-buffer-session-id (cadr terminal-key)))
          (lispm-agents-roster-notify terminal '(identity agents))
          (lispm-agents-roster--flush)
          (should (equal (buffer-local-value 'lispm-office--selected office) terminal-key))
          (should (equal (buffer-local-value 'lispm-office-inspect--key inspector) terminal-key))
          (should (eq (buffer-local-value 'lispm-office-inspect--tab inspector) 'mailbox)))))))

(ert-deftest lispm-office-plugin-toggle-swaps-same-window-and-preserves-conversation ()
  (lispm-office-plugin-test--isolated
    (switch-to-buffer chat)
    (dotimes (line 120) (insert (format "Unsent draft line %d\n" line)))
    (goto-char (point-min))
    (forward-line 45)
    (set-window-start (selected-window) (save-excursion (forward-line -10) (point)))
    (let ((conversation-window (selected-window))
          (window-count (length (window-list)))
          (draft (buffer-string))
          (draft-point (point))
          (draft-start (window-start))
          (draft-modified (buffer-modified-p)))
      (lispm-office-plugin-mode 1)
      (call-interactively (key-binding (kbd "C-c O")))
      (let ((office (get-buffer "*LispM Office*")))
        (should (eq (selected-window) conversation-window))
        (should (= (length (window-list)) window-count))
        (should (eq (window-buffer conversation-window) office))
        (should-not (window-parameter conversation-window 'window-side))
        (with-current-buffer office
          (should (equal lispm-office--selected key))
          (should lispm-office--room)
          (should (equal lispm-office--room
                         (plist-get (seq-find
                                     (lambda (node) (equal (plist-get node :key) key))
                                     (plist-get lispm-office--plan :nodes))
                                    :room)))
          (should-not lispm-office--timer))
        (should (memq #'lispm-office--changed lispm-agents-roster-change-functions))
        (lispm-office-toggle)
        (should-not (get-buffer-window "*LispM Office*"))
        (should-not lispm-agents-roster-change-functions)
        (should (buffer-live-p source))
        (should (buffer-live-p chat))
        (should (eq (window-buffer conversation-window) chat))
        (should (eq (selected-window) conversation-window))
        (should (= (length (window-list)) window-count))
        (should (eq (current-buffer) chat))
        (with-current-buffer chat
          (should (equal (buffer-string) draft))
          (should (= (point) draft-point))
          (should (eq (buffer-modified-p) draft-modified)))
        (should (= (window-start) draft-start))
        (should (= (window-point) draft-point))))))

