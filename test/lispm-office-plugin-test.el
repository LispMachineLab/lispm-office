;;; lispm-office-plugin-test.el --- Agent plugin contract tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'lispm-office-plugin)
(when (locate-library "lispm-agents-roster")
  (require 'lispm-agents-roster))

(defvar lispm-chat-mode-hook nil)
(defvar lispm-session-mode-hook nil)

(defmacro lispm-office-plugin-test--isolated (&rest body)
  "Run BODY with idle native agents and no external effects.
The real roster resolves source identities.  Network, subprocess,
model requests, messages and permission actions must never run."
  (declare (indent 0) (debug t))
  `(progn
     (skip-unless (featurep 'lispm-agents-roster))
     (skip-unless (and (not lispm-office-plugin-mode)
                       (not (get-buffer "*LispM Office*"))
                       (not (get-buffer "*LispM Office Preview*"))))
     (let* ((before-buffers (buffer-list))
            (directory (make-temp-file "lispm-office-plugin-" t))
            (lispm-directory directory)
            (lispm-office-seat-file (expand-file-name "seats.eld" directory))
            (lispm-office-animate nil)
            (lispm-office--buffers nil)
            (lispm-office-inspect--buffers nil)
            (lispm-chat-mode-hook nil)
            (lispm-session-mode-hook nil)
            (lispm-agents-sessions-changed-hook nil)
            (window-selection-change-functions nil)
            (window-buffer-change-functions nil)
            (window-size-change-functions nil)
            (window-state-change-functions nil)
            (lispm-ui-palette-changed-hook nil)
            (lispm-agents--archived nil)
            (lispm-agents-defined nil)
            (lispm-agents--session-cache (make-hash-table :test #'equal))
            (lispm-agents-session-lookup-functions nil)
            (lispm-agents-roster-change-functions nil)
            (lispm-agents-roster--timer nil)
            (lispm-agents-roster--keys nil)
            (lispm-agents-roster--fields nil)
            (lispm-agents-roster--events nil)
            (lispm-agents-roster--pending-buffers nil)
            (lispm-agents-roster--all nil)
            (lispm-agents-roster--previous nil)
            (lispm-agents-roster--sequence 0)
            (lispm-collab--requests nil)
            (source (generate-new-buffer " *Office plugin transcript*"))
            (chat (generate-new-buffer " *Office plugin chat*"))
            (other-source (generate-new-buffer " *Office plugin other agent*"))
            (ordinary (generate-new-buffer " *Office plugin ordinary*"))
            (key '(lispm "office-plugin-session"))
            (other-key '(lispm "office-plugin-other-session"))
            (agent (lispm-agent--create :name 'office-plugin :id (cadr key)
                                        :root directory :buffer source :state 'idle))
            (other-agent (lispm-agent--create :name 'office-plugin-other :id (cadr other-key)
                                              :root directory :buffer other-source :state 'idle))
            (lispm--agents (list (cons 'office-plugin agent)
                                 (cons 'office-plugin-other other-agent)))
            (forbidden (lambda (&rest _) (ert-fail "Plugin attempted an external effect"))))
       (with-current-buffer source
         (setq-local lispm-session-agent agent major-mode 'lispm-session-mode))
       (with-current-buffer chat
         (setq-local lispm-chat-agent agent major-mode 'lispm-chat-mode))
       (with-current-buffer other-source
         (setq-local lispm-session-agent other-agent major-mode 'lispm-session-mode))
       (unwind-protect
           (cl-letf (((symbol-function 'url-retrieve) forbidden)
                     ((symbol-function 'url-retrieve-synchronously) forbidden)
                     ((symbol-function 'make-network-process) forbidden)
                     ((symbol-function 'make-process) forbidden)
                     ((symbol-function 'start-process) forbidden)
                     ((symbol-function 'lispm--request) forbidden)
                     ((symbol-function 'lispm-resolve) forbidden)
                     ((symbol-function 'lispm-tell) forbidden)
                     ((symbol-function 'lispm-abort) forbidden)
                     ((symbol-function 'lispm-agents-bridge-deliver) forbidden))
             (save-window-excursion ,@body))
         (lispm-office-plugin-mode -1)
         (dolist (buffer (cl-set-difference (buffer-list) before-buffers))
           (when (buffer-live-p buffer)
             (with-current-buffer buffer (set-buffer-modified-p nil))
             (kill-buffer buffer)))
         (when (timerp lispm-agents-roster--timer)
           (cancel-timer lispm-agents-roster--timer))
         (delete-directory directory t)))))

(defun lispm-office-plugin-test--selection-event ()
  "Dispatch the same frame event used by Emacs after window selection."
  (run-hook-with-args 'window-selection-change-functions (selected-frame)))

(defun lispm-office-plugin-test--source-window (buffer)
  "Select a new window showing BUFFER while Office remains visible."
  (let ((window (split-window (selected-window) nil 'right)))
    (set-window-buffer window buffer)
    (select-window window)
    window))

(defun lispm-office-plugin-test--click-view-control (label)
  "Click the rendered header control with LABEL in the selected window."
  (let* ((switcher (lispm-office--view-switcher))
         (index (cl-loop for index below (length switcher)
                         when (equal label (get-text-property index 'lispm-ui-label switcher))
                         return index))
         (map (and index (get-text-property index 'local-map switcher)))
         (command (and map (lookup-key map [header-line mouse-1]))))
    (should (commandp command))
    (funcall command (list 'mouse-1 (list (selected-window) 'header-line '(0 . 0) 0)))))

(ert-deftest lispm-office-plugin-enable-is-lazy-and-attaches-existing-agents ()
  (lispm-office-plugin-test--isolated
    (let ((command-hooks (copy-sequence post-command-hook))
          (timers (copy-sequence timer-list))
          (idle-timers (copy-sequence timer-idle-list)))
      (lispm-office-plugin-mode 1)
      (dolist (buffer (list source chat other-source))
        (should (buffer-local-value 'lispm-office-agent-mode buffer)))
      (should-not (buffer-local-value 'lispm-office-agent-mode ordinary))
      (should-not lispm-office--buffers)
      (should-not lispm-agents-roster-change-functions)
      (should-not lispm-agents-roster--timer)
      (should (equal post-command-hook command-hooks))
      (should (equal timer-list timers))
      (should (equal timer-idle-list idle-timers))
      (with-current-buffer chat
        (should (eq (key-binding (kbd "C-c O")) #'lispm-office-toggle))
        (should-not (lookup-key lispm-office-agent-mode-map (kbd "C-c C-o")))))))

(ert-deftest lispm-office-plugin-header-switcher-preserves-and-restores-host-header ()
  (lispm-office-plugin-test--isolated
    (with-current-buffer source
      (setq-local header-line-format '("Existing session header")))
    (with-current-buffer chat (kill-local-variable 'header-line-format))
    (let ((source-header (buffer-local-value 'header-line-format source))
          (chat-header (buffer-local-value 'header-line-format chat)))
      (lispm-office-plugin-mode 1)
      (dolist (buffer (list source chat))
        (with-current-buffer buffer
          (should (string-match-p "lispm-office--view-switcher"
                                  (prin1-to-string header-line-format)))
          (let ((switcher (lispm-office--view-switcher)))
            (dolist (label '("Conversation" "Work"))
              (should (cl-loop for index below (length switcher)
                               thereis (equal label (get-text-property index 'lispm-ui-label switcher)))))
            (should (cl-loop for index below (length switcher)
                             thereis (keymapp (get-text-property index 'local-map switcher)))))))
      (with-current-buffer source
        (should (string-match-p "Existing session header" (prin1-to-string header-line-format))))
      (let ((installed-header (buffer-local-value 'header-line-format source)))
        (lispm-office-plugin-mode 1)
        (should (equal (buffer-local-value 'header-line-format source) installed-header)))
      (switch-to-buffer chat)
      (let ((office (lispm-office)))
        (with-current-buffer office
          (should (string-match-p "lispm-office--view-switcher"
                                  (prin1-to-string header-line-format)))
          (should (stringp (lispm-office--view-switcher)))))
      (lispm-office-plugin-mode -1)
      (with-current-buffer source
        (should (local-variable-p 'header-line-format))
        (should (equal header-line-format source-header)))
      (with-current-buffer chat
        (should-not (local-variable-p 'header-line-format))
        (should (equal header-line-format chat-header))))))

(ert-deftest lispm-office-plugin-header-controls-switch-the-current-view ()
  (lispm-office-plugin-test--isolated
    (switch-to-buffer chat)
    (lispm-office-plugin-mode 1)
    (let ((conversation-window (selected-window))
          (window-count (length (window-list))))
      (lispm-office-plugin-test--click-view-control "Conversation")
      (should (eq (window-buffer conversation-window) chat))
      (lispm-office-plugin-test--click-view-control "Work")
      (let ((office (get-buffer "*LispM Office*")))
        (should (eq (window-buffer conversation-window) office))
        (lispm-office-plugin-test--click-view-control "Work")
        (should (eq (window-buffer conversation-window) office))
        (lispm-office-plugin-test--click-view-control "Conversation")
        (should (eq (window-buffer conversation-window) chat))
        (should (eq (selected-window) conversation-window))
        (should (= (length (window-list)) window-count))))))

(ert-deftest lispm-office-plugin-attaches-new-chat-and-transcript-buffers ()
  (lispm-office-plugin-test--isolated
    (lispm-office-plugin-mode 1)
    (dolist (spec `((lispm-chat-agent lispm-chat-mode lispm-chat-mode-hook ,agent)
                    (lispm-session-agent lispm-session-mode lispm-session-mode-hook ,other-agent)))
      (with-temp-buffer
        (set (make-local-variable (nth 0 spec)) (nth 3 spec))
        (setq-local major-mode (nth 1 spec))
        (run-hooks (nth 2 spec))
        (should lispm-office-agent-mode)
        (should (equal (lispm-office--context-key (current-buffer))
                       (lispm-agents-roster-key (nth 3 spec))))))
    ;; Sessions discovered through the agent registry get the same binding.
    (with-temp-buffer
      (setq-local lispm-session-agent agent major-mode 'lispm-session-mode)
      (run-hooks 'lispm-agents-sessions-changed-hook)
      (should lispm-office-agent-mode))
    (should-not lispm-agents-roster-change-functions)))

(ert-deftest lispm-office-plugin-native-context-uses-chat-owner ()
