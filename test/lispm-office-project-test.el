;;; lispm-office-project-test.el --- Directory work navigation -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'lispm-office-plugin)
(when (locate-library "lispm-agents-roster")
  (require 'lispm-agents-roster))

(defun lispm-office-project-test--record (id root state queued &optional buffer)
  "Make a cheap roster record for ID at ROOT with STATE and QUEUED input."
  (list :key (list 'lispm id) :name id :kind 'lispm :root root :alive t
        :status (list :state state) :mailbox (list :queued queued) :buffer buffer))

(defun lispm-office-project-test--keys (buffer)
  "Return sorted visible session ids in BUFFER."
  (sort (mapcar (lambda (record) (cadr (plist-get record :key)))
                (buffer-local-value 'lispm-office--records buffer)) #'string<))

(defmacro lispm-office-project-test--isolated (&rest body)
  "Run BODY with cached records and isolated source/sidebar windows.
No model requests, process launches, details, or user files are accessed."
  (declare (indent 0) (debug t))
  `(progn
     (skip-unless (featurep 'lispm-agents-roster))
     (skip-unless (and (not lispm-office-plugin-mode)
                       (not (get-buffer "*LispM Office*"))))
     (let* ((before-buffers (buffer-list))
            (directory (make-temp-file "lispm-office-project-" t))
            (alpha (file-name-as-directory (expand-file-name "alpha" directory)))
            (beta (file-name-as-directory (expand-file-name "beta" directory)))
            (empty (file-name-as-directory (expand-file-name "empty" directory)))
            (lispm-directory directory)
            (lispm-office-seat-file (expand-file-name "seats.eld" directory))
            (lispm-office-animate nil)
            (lispm-office-follow-current-agent t)
            (lispm-office--buffers nil)
            (lispm-office-inspect--buffers nil)
            (lispm-chat-mode-hook nil)
            (lispm-session-mode-hook nil)
            (lispm-agents-sessions-changed-hook nil)
            (lispm-agents-roster-change-functions nil)
            (lispm-desktop-agent-list-open-project-functions nil)
            (window-selection-change-functions nil)
            (window-buffer-change-functions nil)
            (window-size-change-functions nil)
            (window-state-change-functions nil)
            (lispm-ui-palette-changed-hook nil)
            (source (generate-new-buffer " *Project source draft*"))
            (other-source (generate-new-buffer " *Project other source*"))
            (sidebar (generate-new-buffer " *Project sidebar*"))
            (ordinary (generate-new-buffer " *Project ordinary*"))
            (conversation-window (selected-window))
            (lispm-agents-main-window-function (lambda () conversation-window))
            (roster-reads 0)
            (records (list
                      (lispm-office-project-test--record "source" alpha 'working 0 source)
                      (lispm-office-project-test--record "idle" alpha 'idle 0)
                      (lispm-office-project-test--record "queued" alpha 'idle 2)
                      (lispm-office-project-test--record "blocked" alpha 'blocked 0)
                      (lispm-office-project-test--record "error" alpha 'error nil)
                      (lispm-office-project-test--record "done" alpha 'done 0)
                      (lispm-office-project-test--record "unknown" alpha nil nil)
                      (lispm-office-project-test--record "ended" alpha 'working 2)
                      (lispm-office-project-test--record "other" beta 'working 0 other-source)))
            (forbidden (lambda (&rest _) (ert-fail "Directory view attempted an external effect"))))
       (dolist (root (list alpha beta empty)) (make-directory root))
       (setf (plist-get (nth 7 records) :alive) nil)
       (with-current-buffer source
         (setq-local default-directory alpha major-mode 'lispm-chat-mode))
       (with-current-buffer other-source
         (setq-local default-directory beta major-mode 'lispm-chat-mode))
       (unwind-protect
           (cl-letf (((symbol-function 'lispm-office--source-p)
                      (lambda (buffer) (memq buffer (list source other-source))))
                     ((symbol-function 'lispm-office--context-key)
                      (lambda (buffer) (cond ((eq buffer source) '(lispm "source"))
                                             ((eq buffer other-source) '(lispm "other")))))
                     ((symbol-function 'lispm-agents-roster)
                      (lambda () (cl-incf roster-reads) records))
                     ((symbol-function 'lispm-agents-roster-details) forbidden)
                     ((symbol-function 'lispm-agents-waiting-buffers) (lambda () nil))
                     ((symbol-function 'lispm-office--graphic-p) (lambda () nil))
                     ((symbol-function 'url-retrieve) forbidden)
                     ((symbol-function 'url-retrieve-synchronously) forbidden)
                     ((symbol-function 'make-network-process) forbidden)
                     ((symbol-function 'make-process) forbidden)
                     ((symbol-function 'start-process) forbidden)
                     ((symbol-function 'lispm--request) forbidden)
                     ((symbol-function 'lispm-tell) forbidden)
                     ((symbol-function 'lispm-resolve) forbidden))
             (save-window-excursion
               (switch-to-buffer source)
               ,@body))
         (lispm-office-plugin-mode -1)
         (dolist (buffer (cl-set-difference (buffer-list) before-buffers))
           (when (buffer-live-p buffer)
             (with-current-buffer buffer (set-buffer-modified-p nil))
             (kill-buffer buffer)))
         (delete-directory directory t)))))

(ert-deftest lispm-office-project-directory-includes-live-idle-and-done-agents ()
  (lispm-office-project-test--isolated
    ;; A normalized directory matches the native record without a trailing slash.
    (setf (plist-get (car records) :root) (directory-file-name alpha))
    (let ((office (lispm-office-open-project (concat alpha "../alpha"))))
      (should (equal (lispm-office-project-test--keys office)
                     '("blocked" "done" "error" "idle" "queued" "source" "unknown")))
      (with-current-buffer office
        (should (eq lispm-office--scope 'project))
        (should (equal lispm-office--project-root alpha))
        (should-not lispm-office--source-buffer)
        (should-not lispm-office--working-only)
        (should lispm-office--room)
        (should (= (length lispm-office--all-records) (length records)))
        (should (= (length (plist-get lispm-office--state :seats)) (length records)))
        (should (equal (cdr (assq 'working-only (lispm-office--view-choices)))
                       "Working only"))
        (should-not (string-match-p "waiting for session identity" (buffer-string))))
      (should (= roster-reads 1)))))

(ert-deftest lispm-office-project-default-keeps-completed-sessions-until-ended ()
  (lispm-office-project-test--isolated
    (let ((office (lispm-office-open-project alpha)))
      (setf (plist-get (car records) :status) '(:state done)
            (plist-get (nth 2 records) :mailbox) '(:queued 0))
      (run-hook-with-args 'lispm-agents-roster-change-functions
                          '((lispm "source") (lispm "queued")) '(status mailbox) nil)
      (should (equal (lispm-office-project-test--keys office)
                     '("blocked" "done" "error" "idle" "queued" "source" "unknown")))
      ;; Finishing a turn is not deactivation.  Only an ended session disappears.
      (setf (plist-get (car records) :alive) nil
            (plist-get (car records) :mailbox) '(:queued 2))
      (run-hook-with-args 'lispm-agents-roster-change-functions
                          '((lispm "source")) '(alive mailbox) nil)
      (should (equal (lispm-office-project-test--keys office)
                     '("blocked" "done" "error" "idle" "queued" "unknown")))
      (should (= roster-reads 3)))))

(ert-deftest lispm-office-project-sidebar-navigation-preserves-draft-and-return-window ()
  (lispm-office-project-test--isolated
    (dotimes (line 120) (insert (format "Unsent project draft %d\n" line)))
    (goto-char (point-min))
    (forward-line 45)
    (set-window-start conversation-window (save-excursion (forward-line -10) (point)))
    (let ((draft (buffer-string)) (draft-point (point))
          (draft-start (window-start conversation-window))
          (draft-modified (buffer-modified-p))
          (sidebar-window (split-window conversation-window nil 'right)))
      (set-window-buffer sidebar-window sidebar)
      (select-window sidebar-window)
      (let ((office (lispm-office-open-project beta)))
        (should (eq (window-buffer sidebar-window) sidebar))
        (should (eq (window-buffer conversation-window) office))
        (should (eq (selected-window) conversation-window))
        (should (equal (lispm-office-project-test--keys office) '("other")))
        ;; Another folder click updates the reused Work view, not its return target.
        (select-window sidebar-window)
        (should (eq (lispm-office-open-project alpha) office))
        (should (eq (plist-get (window-parameter conversation-window 'lispm-office-source)
                               :buffer) source))
        (should (= (length (window-list)) 2))
        (call-interactively (lookup-key lispm-office-mode-map (kbd "q")))
        (should (eq (window-buffer conversation-window) source))
        (should (eq (window-buffer sidebar-window) sidebar))
        (should (= (window-point conversation-window) draft-point))
        (should (= (window-start conversation-window) draft-start))
        (with-current-buffer source
          (should (equal (buffer-string) draft))
          (should (eq (buffer-modified-p) draft-modified)))
        (should-not (buffer-live-p office))
        (should-not lispm-agents-roster-change-functions)))))

(ert-deftest lispm-office-project-command-from-agent-window-uses-host-main-window ()
  (lispm-office-project-test--isolated
    (insert "Main window's unsent draft")
    (let ((other-window (split-window conversation-window nil 'right)))
      (set-window-buffer other-window other-source)
      (select-window other-window)
      (insert "Secondary agent's unsent draft")
      ;; Interactive invocation uses this secondary conversation's directory,
      ;; while the host main window remains the destination for the project.
      (call-interactively #'lispm-office-open-project)
      (let ((office (get-buffer "*LispM Office*")))
        (should (eq (window-buffer conversation-window) office))
        (should (eq (selected-window) conversation-window))
        (should (eq (window-buffer other-window) other-source))
        (should (equal (lispm-office-project-test--keys office) '("other")))
        (should (eq (plist-get (window-parameter conversation-window 'lispm-office-source)
                               :buffer) source))
        (lispm-office-return)
        (should (eq (window-buffer conversation-window) source))
        (should (eq (window-buffer other-window) other-source))
        (with-current-buffer source
          (should (equal (buffer-string) "Main window's unsent draft")))
        (with-current-buffer other-source
          (should (equal (buffer-string) "Secondary agent's unsent draft")))))))

(ert-deftest lispm-office-project-pinned-directory-ignores-source-follow-events ()
  (lispm-office-project-test--isolated
    (lispm-office-plugin-mode 1)
    (let* ((office (lispm-office-open-project alpha))
           (selection (buffer-local-value 'lispm-office--selected office))
           (other-window (split-window conversation-window nil 'right)))
      (dolist (buffer (list other-source ordinary source))
        (set-window-buffer other-window buffer)
        (select-window other-window)
        (run-hook-with-args 'window-selection-change-functions (selected-frame))
        (run-hook-with-args 'window-buffer-change-functions (selected-frame))
        (should (equal (buffer-local-value 'lispm-office--project-root office) alpha))
        (should (equal (buffer-local-value 'lispm-office--selected office) selection))
        (should (equal (lispm-office-project-test--keys office)
                       '("blocked" "done" "error" "idle" "queued" "source" "unknown"))))
      (should (= roster-reads 1)))))

(ert-deftest lispm-office-project-changing-directory-survives-controls-and-updates ()
  (lispm-office-project-test--isolated
    (let ((office (lispm-office-open-project alpha)))
      (lispm-office-open-project beta)
      (with-current-buffer office
        (lispm-office-overview)
        (should (= (length lispm-office--records) (length records)))
        (lispm-office-project)
        (lispm-office-refresh)
        (should (equal lispm-office--project-root beta))
        (should (eq lispm-office--scope 'project)))
      (should (equal (lispm-office-project-test--keys office) '("other")))
      ;; A regular Work toggle after return restores the existing session behavior.
      (lispm-office-return)
      (setq office (lispm-office))
      (with-current-buffer office
        (should-not lispm-office--project-root)
        (should-not lispm-office--working-only)
        (should (eq lispm-office--scope 'session)))
      (should (equal (lispm-office-project-test--keys office) '("source"))))))

(ert-deftest lispm-office-project-empty-directory-never-falls-back-to-global-selection ()
  (lispm-office-project-test--isolated
    (let ((office (lispm-office-open-project alpha)))
      (lispm-office-open-project empty)
      (with-current-buffer office
        (should (equal lispm-office--project-root empty))
        (should-not lispm-office--records)
        (should-not lispm-office--selected)
        (should (string-match-p "No active agents"
                                (buffer-string)))
        (should-not (string-match-p "No agents currently working" (buffer-string)))
        (should-error (lispm-office--key) :type 'user-error)
        (lispm-office--ingest records)
        (lispm-office-toggle-working-only)
        (should-not lispm-office--records)
        (should-not lispm-office--selected)
        (should (string-match-p "No agents working"
                                (buffer-string)))
        (should (equal lispm-office--project-root empty))))))

(ert-deftest lispm-office-project-roster-event-refilters-work-without-reading-details ()
  (lispm-office-project-test--isolated
    (let* ((office (lispm-office-open-project alpha))
           (seats (copy-tree (buffer-local-value 'lispm-office--state office))))
      ;; Restricting live conversations to current activity is an explicit choice.
      (with-current-buffer office (lispm-office-toggle-working-only))
      (should (equal (lispm-office-project-test--keys office)
                     '("blocked" "error" "queued" "source")))
      ;; Settled work leaves the view; newly working or queued input enters it.
      (setf (plist-get (car records) :status) '(:state done)
            (plist-get (nth 1 records) :status) '(:state working)
            (plist-get (nth 2 records) :mailbox) '(:queued 0)
            (plist-get (nth 5 records) :mailbox) '(:queued 1))
      (run-hook-with-args 'lispm-agents-roster-change-functions
                          '((lispm "source") (lispm "idle") (lispm "queued") (lispm "done"))
                          '(status mailbox) nil)
      (should (equal (lispm-office-project-test--keys office) '("blocked" "done" "error" "idle")))
      (should (= roster-reads 2))
      (with-current-buffer office
        (should (equal lispm-office--state seats))
        (should-not (equal lispm-office--selected '(lispm "source")))
        (lispm-office-toggle-working-only)
        (should (member "source" (lispm-office-project-test--keys office)))
        (should (member "unknown" (lispm-office-project-test--keys office)))
        (should-not (member "ended" (lispm-office-project-test--keys office)))
        (lispm-office-toggle-working-only)
        (should (equal (lispm-office-project-test--keys office) '("blocked" "done" "error" "idle"))))
      ;; Controls reuse the cached snapshot instead of rereading agent state.
      (should (= roster-reads 2)))))

(ert-deftest lispm-office-project-plugin-hook-is-optional-lazy-and-reversible ()
  (lispm-office-project-test--isolated
    (let* ((other-handler (lambda (_directory) nil))
           (original-require (symbol-function 'require))
           (timers (copy-sequence timer-list))
           (idle-timers (copy-sequence timer-idle-list)))
      (add-hook 'lispm-desktop-agent-list-open-project-functions other-handler)
      (cl-letf (((symbol-function 'require)
                 (lambda (feature &rest args)
                   (should-not (string-prefix-p "lispm-desktop" (symbol-name feature)))
                   (apply original-require feature args))))
        (lispm-office-plugin-mode 1)
        (lispm-office-plugin-mode 1))
      (should (= (cl-count #'lispm-office-open-project
                          lispm-desktop-agent-list-open-project-functions) 1))
      (should-not lispm-agents-roster-change-functions)
      (should (= roster-reads 0))
      (should (equal timers timer-list))
      (should (equal idle-timers timer-idle-list))
      (should (run-hook-with-args-until-success
               'lispm-desktop-agent-list-open-project-functions beta))
      (let ((office (get-buffer "*LispM Office*")))
        (should (equal (lispm-office-project-test--keys office) '("other")))
        (lispm-office-plugin-mode -1)
        (should-not (buffer-live-p office))
        (should (eq (window-buffer conversation-window) source)))
      (should (equal lispm-desktop-agent-list-open-project-functions (list other-handler)))
      (should-not lispm-agents-roster-change-functions)
      (lispm-office-plugin-mode 1)
      (lispm-office-plugin-mode -1)
      (should (equal lispm-desktop-agent-list-open-project-functions (list other-handler))))))

(provide 'lispm-office-project-test)
;;; lispm-office-project-test.el ends here
