;;; lispm-office-render-test.el --- Tests of the Office drawing -*- lexical-binding: t; -*-

(require 'ert)
(require 'lispm-office-render)
(require 'xml)

(defun lispm-office-render-test--plan ()
  "Return a small drawing fixture with two rooms and three agents."
  (let* ((a '(:key (lispm "a") :name "Ada" :kind lispm :x 20 :y 55 :width 90 :height 80
              :room 0 :slot 0 :status (:state working) :mailbox (:queued 2)
              :waits-on ((claude "b"))))
         (b '(:key (claude "b") :name "Claude" :kind claude :x 120 :y 55 :width 90 :height 80
              :room 0 :slot 1 :status (:state blocked :kind permission) :mailbox (:queued 0)))
         (c '(:key (codex "c") :name "Codex" :kind codex :x 470 :y 55 :width 90 :height 80
              :room 1 :slot 0 :status (:state idle)))
         (rooms (list (list :id 0 :label "Home" :x 0 :y 0 :width 450 :height 454 :nodes (list a b))
                      (list :id 1 :label "Project" :x 450 :y 0 :width 450 :height 454 :nodes (list c)))))
    (copy-tree (list :width 900 :height 454 :rooms rooms :nodes (list a b c)))))

(ert-deftest lispm-office-render-projection-and-hit-test-agree ()
  (let ((plan (lispm-office-render-test--plan)))
    (dolist (scale '(0.45 0.71 0.72 1.0 2.0))
      (should (equal (lispm-office-render-hit-test plan (* 40 scale) (* 80 scale) scale)
                     '(:key (lispm "a")))))
    (should (equal (lispm-office-render-hit-test plan 40 80 1 1) '(:key (codex "c"))))
    (should-not (lispm-office-render-hit-test plan -1 10 1))
    (should-not (lispm-office-render-hit-test plan 900 10 1))
    (should-not (lispm-office-render-hit-test plan 110 80 1))))

(ert-deftest lispm-office-render-map-hits-a-room-not-a-desk ()
  (let* ((plan (lispm-office-render-test--plan))
         (svg (lispm-office-render-svg plan '(lispm "a") 0.25 0)))
    (should (equal (dom-attr svg 'data-view) "map"))
    (should (equal (lispm-office-render-hit-test plan 125 20 0.25) '(:room 1)))
    (should-not (dom-by-class svg "office-desk"))
    (should (= (length (dom-by-class svg "office-room")) 2))))

(ert-deftest lispm-office-render-focus-and-image-cap-agree ()
  (let* ((plan (lispm-office-render-test--plan))
         (projection (lispm-office-render-projection plan 100 1))
         (scale (plist-get projection :scale))
         (svg (lispm-office-render-svg plan nil 100 0 1)))
    (should (<= (dom-attr svg 'width) lispm-office-render-max-pixels))
    (should (<= (dom-attr svg 'height) lispm-office-render-max-pixels))
    (should (equal (dom-attr svg 'viewBox) "450 0 450 454"))
    (should (= (length (dom-by-class svg "office-desk")) 1))
    (should (equal (lispm-office-render-hit-test plan (* 40 scale) (* 80 scale) 100 1)
                   '(:key (codex "c"))))))

(ert-deftest lispm-office-render-rejects-invalid-scale ()
  (dolist (scale '(0 -1 nil "1"))
    (should-error (lispm-office-render-projection nil scale) :type 'wrong-type-argument)))

(ert-deftest lispm-office-render-distinguishes-blocked-kinds ()
  (should (equal (lispm-office-render--badge '(:status (:state blocked :kind permission))) "!"))
  (should (equal (lispm-office-render--badge '(:status (:state blocked :kind question))) "?"))
  (should (equal (lispm-office-render--badge '(:status (:state blocked :kind auth))) "AUTH"))
  (should-not (lispm-office-render--badge '(:status (:state idle)))))

(ert-deftest lispm-office-render-animates-only-working-pose ()
  (let* ((plan (lispm-office-render-test--plan))
         (a (lispm-office-render-svg plan nil 1 0))
         (b (lispm-office-render-svg plan nil 1 1)))
    (should-not (equal a b))
    (setf (plist-get (car (plist-get plan :nodes)) :status) '(:state idle))
    (should (equal (lispm-office-render-svg plan nil 1 0)
                   (lispm-office-render-svg plan nil 1 1)))))

(ert-deftest lispm-office-render-only-actual-message-events-make-envelopes ()
  (let* ((plan (lispm-office-render-test--plan))
         (ordinary (lispm-office-render-svg plan nil 1 0))
         (message (lispm-office-render-svg
                   plan nil 1 0 nil '((:type message-queued :from "Ada" :to "Claude" :progress 0.3))))
         (unknown (lispm-office-render-svg
                   plan nil 1 0 nil '((:type message-queued :from "Nobody" :to "Claude"))))
         (state (lispm-office-render-svg
                 plan nil 1 0 nil '((:type state-changed :from "Ada" :to "Claude")))))
    (should-not (dom-by-class ordinary "office-wait"))
    (should-not (dom-by-class ordinary "office-envelope"))
    (should (= (length (dom-by-class message "office-envelope")) 1))
    (should-not (dom-by-class unknown "office-envelope"))
    (should-not (dom-by-class state "office-envelope"))))

(ert-deftest lispm-office-render-labels-do-not-become-markup ()
  (let ((plan (lispm-office-render-test--plan)))
    (setf (plist-get (car (plist-get plan :nodes)) :name) "<script>&bad")
    (let ((svg (lispm-office-render-svg plan nil 1 0)))
      (should-not (dom-by-tag svg 'script))
      (with-temp-buffer
        (svg-print svg)
        (should (string-match-p "&lt;script&gt;&amp;bad" (buffer-string)))))))

(ert-deftest lispm-office-render-text-preserves-identity-and-unknowns ()
  (with-temp-buffer
    (lispm-office-render-text (lispm-office-render-test--plan) '(codex "c"))
    (goto-char (point-min))
    (search-forward "Codex")
    (should (equal (get-text-property (1- (point)) 'lispm-office-key) '(codex "c")))
    (should (equal (get-text-property (1- (point)) 'lispm-office-room) 1))
    (should (string-match-p (regexp-quote "inbox:?") (buffer-string)))
    (should (string-match-p "Waits on: Claude" (buffer-string)))))

(ert-deftest lispm-office-render-is-pure-for-layout-and-events ()
  (let* ((plan (lispm-office-render-test--plan))
         (before (copy-tree plan))
         (events '((:type message-taken :from (lispm "a") :to (claude "b") :progress 0.5)))
         (events-before (copy-tree events)))
    (lispm-office-render-svg plan '(lispm "a") 1 1 nil events)
    (with-temp-buffer (lispm-office-render-text plan '(lispm "a")))
    (should (equal plan before))
    (should (equal events events-before))))

(ert-deftest lispm-office-render-avatar-animation-does-not-read-files ()
  (let ((lispm-office-render--avatars (make-hash-table :test #'equal))
        (reads 0))
    (cl-letf (((symbol-function 'lispm-office-render--read-avatar)
               (lambda (_path) (setq reads (1+ reads)) (svg-create 18 18))))
      (dotimes (_ 3)
        (lispm-office-render--avatar (svg-create 100 100) "/tmp/character.svg" 0 0))
      (should (= reads 1))
      (lispm-office-render-clear-cache)
      (lispm-office-render--avatar (svg-create 100 100) "/tmp/character.svg" 0 0)
      (should (= reads 2)))))

(ert-deftest lispm-office-render-native-name-keeps-session-suffix ()
  (dolist (example '(("assistant@long-workspace-name<2>" . "<2>")
                     ("pair-programmer@long-workspace-name<123>" . "<123>")))
    (let ((plan (lispm-office-render-test--plan)))
      (setf (plist-get (car (plist-get plan :nodes)) :name) (car example))
      (let ((text (with-temp-buffer
                    (svg-print (lispm-office-render-svg plan '(lispm "a") 1 0))
                    (dom-texts (car (xml-parse-region (point-min) (point-max)))))))
        (should (string-match-p (regexp-quote (cdr example)) text))
        (should-not (string-match-p "long-workspace-name" text))))))

(ert-deftest lispm-office-render-worker-preserves-configured-svg-avatar ()
  (skip-unless (fboundp 'libxml-parse-xml-region))
  (let ((avatar (make-temp-file
                 "lispm-office-avatar-" nil ".svg"
                 "<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 18 18\"><circle id=\"configured-avatar-mark\" cx=\"9\" cy=\"9\" r=\"8\" fill=\"#123456\"/></svg>"))
        (lispm-office-render--avatars (make-hash-table :test #'equal))
        (plan (lispm-office-render-test--plan)))
    (unwind-protect
        (progn
          (setf (plist-get (car (plist-get plan :nodes)) :avatar) avatar)
          (should (dom-by-id (lispm-office-render-svg plan '(lispm "a") 1 0)
                             "configured-avatar-mark"))
          ;; The working pose must keep the configured face from cache,
          ;; even when its original file is no longer available.
          (delete-file avatar)
          (should (dom-by-id (lispm-office-render-svg plan '(lispm "a") 1 1)
                             "configured-avatar-mark")))
      (when (file-exists-p avatar) (delete-file avatar)))))

(ert-deftest lispm-office-render-pixel-catalog-has-distinct-grid-portraits ()
  (should (>= (length lispm-office-render--portraits) 16))
  (let (ids drawings)
    (seq-doseq (portrait lispm-office-render--portraits)
      (push (plist-get portrait :id) ids)
      (let ((pixels (plist-get portrait :pixels))
            (svg (svg-create 32 32)))
        (should (= (length pixels) 16))
        (seq-doseq (row pixels)
          (should (stringp row))
          (should (= (length row) 16))
          (should (string-match-p "\\`[.OHhSsEWAaC]+\\'" row)))
        (lispm-office-render--pixel-portrait svg portrait 0 0 2)
        (let* ((group (car (dom-by-class svg "office-pixel-portrait")))
               (rectangles (dom-by-tag group 'rect)))
          (should group)
          (should (equal (dom-attr group 'shape-rendering) "crispEdges"))
          (should rectangles)
          (dolist (tag '(circle ellipse path polygon image))
            (should-not (dom-by-tag group tag)))
          (dolist (rect rectangles)
            (dolist (attribute '(x y width height))
              (let ((value (dom-attr rect attribute)))
                (should (numberp value))
                (should (zerop (mod value 2)))))
            (should (<= 0 (dom-attr rect 'x)))
            (should (<= 0 (dom-attr rect 'y)))
            (should (<= (+ (dom-attr rect 'x) (dom-attr rect 'width)) 32))
            (should (<= (+ (dom-attr rect 'y) (dom-attr rect 'height)) 32)))
          ;; Compare the visible marks, excluding the identifying metadata.
          (push rectangles drawings))))
    (should (= (length (delete-dups ids)) (length lispm-office-render--portraits)))
    (should (= (length (delete-dups drawings)) (length lispm-office-render--portraits)))))

(ert-deftest lispm-office-render-random-portrait-pool-is-unique-and-stable ()
  (let ((lispm-office-render--portrait-assignments (make-hash-table :test #'equal))
        (lispm-office-render--portrait-pool nil)
        (random-calls 0)
        indexes)
    ;; A controlled random source makes this independent of chance while
    ;; still proving that allocation actually consumes randomness.
    (cl-letf (((symbol-function 'random)
               (lambda (limit)
                 (should (and (integerp limit) (> limit 0)))
                 (cl-incf random-calls)
                 0)))
      (dotimes (index (length lispm-office-render--portraits))
        (let* ((key (list 'lispm (format "portrait-test-%d" index)))
               (node (list :key key :name "Original name"))
               (assigned (lispm-office-render--portrait-index node)))
          (should (integerp assigned))
          (should (<= 0 assigned))
          (should (< assigned (length lispm-office-render--portraits)))
          (push assigned indexes)
          (should (= assigned
                     (lispm-office-render--portrait-index
                      (list :key (copy-tree key) :name "Renamed session"))))))
      (should (> random-calls 0))
      (should (= (length (delete-dups indexes)) (length lispm-office-render--portraits)))
      ;; Exhaustion starts another valid pool, not a missing portrait.
      (let ((next (lispm-office-render--portrait-index '(:key (codex "next-pool")))))
        (should (<= 0 next))
        (should (< next (length lispm-office-render--portraits)))))))

(ert-deftest lispm-office-render-pixel-identity-survives-redraw-theme-and-cache ()
  (let* ((lispm-office-render--portrait-assignments (make-hash-table :test #'equal))
         (lispm-office-render--portrait-pool nil)
         (lispm-office-render--avatars (make-hash-table :test #'equal))
         (plan (lispm-office-render-test--plan))
         (first (car (plist-get plan :nodes)))
         (identity (dom-attr
                    (car (dom-by-class (lispm-office-render-svg plan nil 1 0)
                                       "office-pixel-portrait"))
                    'data-portrait)))
    (should identity)
    (setf (plist-get first :name) "Renamed@workspace<22>")
    (dolist (colors '(("#ffffff" "#111111" "#666666" "#552288")
                      ("#222222" "#eeeeee" "#bbbbbb" "#aa88ee")))
      (let ((lispm-ui-current-palette (apply #'lispm-ui-derive-palette colors)))
        (lispm-office-render-clear-cache)
        (dolist (phase '(0 1 2))
          (should (equal identity
                         (dom-attr
                          (car (dom-by-class (lispm-office-render-svg plan nil 1 phase)
                                             "office-pixel-portrait"))
                          'data-portrait))))))
    (should (= (hash-table-count lispm-office-render--portrait-assignments) 3))))

(defun lispm-office-render-test--responsive-plan ()
  "Return three live desks in room zero and one untouched second room."
  (let* ((plan (lispm-office-render-test--plan))
         (room (car (plist-get plan :rooms)))
         (third '(:key (codex "d") :name "Alan" :kind codex :room 0 :slot 2
                  :x 220 :y 55 :width 90 :height 80 :status (:state idle))))
    (setf (plist-get room :nodes) (append (plist-get room :nodes) (list third))
          (plist-get plan :nodes) (append (plist-get plan :nodes) (list third)))
    plan))

(ert-deftest lispm-office-render-responsive-wide-room-fills-viewport-with-one-row ()
  (let* ((plan (lispm-office-render-test--responsive-plan))
         (before (copy-tree plan))
         (fit (lispm-office-render-fit-room plan 0 782 220))
         (scene (plist-get fit :plan))
         (scale (plist-get fit :scale))
         (room (car (plist-get scene :rooms)))
         (nodes (plist-get room :nodes))
         (svg (lispm-office-render-svg scene '(codex "d") scale 0 0)))
    (should (equal plan before))
    (should (equal (cadr (plist-get scene :rooms)) (cadr (plist-get plan :rooms))))
    (should (equal (seq-find (lambda (node) (equal (plist-get node :key) '(codex "c")))
                             (plist-get scene :nodes))
                   (seq-find (lambda (node) (equal (plist-get node :key) '(codex "c")))
                             (plist-get plan :nodes))))
    (should (<= 0.72 scale 1.5))
    (should (< (abs (- (dom-attr svg 'width) 782)) 0.001))
    (should (< (abs (- (dom-attr svg 'height) 220)) 0.001))
    (should (equal (dom-attr svg 'data-view) "desk"))
    (should (= (length (dom-by-class svg "office-desk")) 3))
    (should (apply #'= (mapcar (lambda (node) (plist-get node :y)) nodes)))
    (should (apply #'< (mapcar (lambda (node) (plist-get node :x)) nodes)))
    ;; Spare width belongs to the office floor and service area, not to
    ;; oversized cells separating people who share a desk bank.
    (should (= (- (plist-get (cadr nodes) :x) (plist-get (car nodes) :x)) 98))
    (should (plist-get room :pods))
    (should (plist-get room :aisles))
    (should (plist-get room :fixtures))
    (dolist (node nodes)
      (should (= (plist-get node :width) 90))
      (should (= (plist-get node :height) 80))
      (should (string-match-p (regexp-quote (plist-get node :name)) (dom-texts svg))))
    ;; The old fixed four-pod decorations extended below this short floor.
    (dolist (rect (dom-by-tag (car (dom-by-class svg "office-room")) 'rect))
      (should (<= (+ (dom-attr rect 'y) (dom-attr rect 'height))
                  (+ (plist-get room :y) (plist-get room :height)))))))

(ert-deftest lispm-office-render-responsive-resize-keeps-slot-order-and-hit-targets ()
  (let ((plan (lispm-office-render-test--responsive-plan)))
    ;; Roster order changes must not change the display order of occupied slots.
    (setf (plist-get (car (plist-get plan :rooms)) :nodes)
          (reverse (plist-get (car (plist-get plan :rooms)) :nodes)))
    (dolist (size '((782 . 220) (240 . 500)))
      (let* ((fit (lispm-office-render-fit-room plan 0 (car size) (cdr size)))
             (scene (plist-get fit :plan))
             (scale (plist-get fit :scale))
             (room (car (plist-get scene :rooms)))
             (nodes (plist-get room :nodes)))
        (should (equal (mapcar (lambda (node) (plist-get node :slot)) nodes) '(0 1 2)))
        ;; A taller wall may favor paired desks even in a narrow pane.
        ;; Reflow must still fit the requested viewport without losing targets.
        (let ((projection (lispm-office-render-projection scene scale 0)))
          (should (< (abs (- (plist-get projection :pixel-width) (car size))) 0.001))
          (should (< (abs (- (plist-get projection :pixel-height) (cdr size))) 0.001)))
        (dolist (node nodes)
          (let ((x (* scale (- (+ (plist-get node :x) 45) (plist-get room :x))))
                (y (* scale (- (+ (plist-get node :y) 40) (plist-get room :y)))))
            (should (equal (lispm-office-render-hit-test scene x y scale 0)
                           (list :key (plist-get node :key))))))))))

(ert-deftest lispm-office-render-responsive-tiny-height-scrolls-without-shrinking-names ()
  (let* ((plan (lispm-office-render-test--responsive-plan))
         (fit (lispm-office-render-fit-room plan 0 240 60))
         (scene (plist-get fit :plan))
         (scale (plist-get fit :scale))
         (projection (lispm-office-render-projection scene scale 0)))
    (should (>= scale 0.72))
    (should (< (abs (- (plist-get projection :pixel-width) 240)) 0.001))
    (should (> (plist-get projection :pixel-height) 60))
    (should (equal (dom-attr (lispm-office-render-svg scene nil scale 0 0) 'data-view) "desk"))))

(ert-deftest lispm-office-render-responsive-manual-map-labels-stay-on-short-floor ()
  (let* ((fit (lispm-office-render-fit-room (lispm-office-render-test--responsive-plan) 0 782 220))
         (scene (plist-get fit :plan))
         (room (car (plist-get scene :rooms)))
         (svg (lispm-office-render-svg scene nil 0.25 0 0)))
    (should (equal (dom-attr svg 'data-view) "map"))
    (should (string-match-p (regexp-quote (plist-get room :label)) (dom-texts svg)))
    (dolist (text (dom-by-tag svg 'text))
      (should (<= (dom-attr text 'y) (+ (plist-get room :y) (plist-get room :height)))))))

(ert-deftest lispm-office-render-responsive-missing-room-and-invalid-dimensions ()
  (let ((plan (lispm-office-render-test--responsive-plan)))
    (should-not (lispm-office-render-fit-room plan nil 782 220))
    (should-not (lispm-office-render-fit-room plan 99 782 220))
    (dolist (size '((0 . 220) (782 . -1) (nil . 220)))
      (should-error (lispm-office-render-fit-room plan 0 (car size) (cdr size))
                    :type 'wrong-type-argument))))

(ert-deftest lispm-office-render-wall-decor-stays-above-the-walkable-floor ()
  (let ((plan (lispm-office-render-test--responsive-plan))
        (lispm-office-render--room-assignments (make-hash-table :test #'equal)))
    (dotimes (style (length lispm-office-render--room-styles))
      (dolist (size '((782 . 220) (240 . 500) (1100 . 700)))
        (let* ((fit (lispm-office-render-fit-room plan 0 (car size) (cdr size)))
               (scene (plist-get fit :plan))
               (room (car (plist-get scene :rooms)))
               (x (plist-get room :x)) (y (plist-get room :y)))
          (puthash (list (plist-get room :root) 0) style lispm-office-render--room-assignments)
          (let* ((svg (lispm-office-render-svg scene nil (plist-get fit :scale) 0 0))
                 (wall (car (dom-by-class svg "office-back-wall")))
                 (floor (car (dom-by-class svg "office-floor-surface")))
                 (objects (dom-by-class svg "office-wall-object")))
            (should (>= (length objects) 2))
            (should (<= (+ (dom-attr wall 'y) (dom-attr wall 'height)) (dom-attr floor 'y)))
            (dolist (object objects)
              (should (>= (dom-attr object 'data-x) x))
              (should (>= (dom-attr object 'data-y) y))
              (should (<= (+ (dom-attr object 'data-x) (dom-attr object 'data-width))
                          (+ x (plist-get room :width))))
              (should (< (+ (dom-attr object 'data-y) (dom-attr object 'data-height))
                         (dom-attr floor 'y))))
            (dolist (node (plist-get room :nodes))
              (should (>= (plist-get node :y) (dom-attr floor 'y))))))))))

(provide 'lispm-office-render-test)
