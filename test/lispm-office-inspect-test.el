;;; lispm-office-inspect-test.el --- Inspector and action tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'tab-bar)
(require 'lispm-office-inspect)
(require 'lispm-office)

;; Public host variables normally bound by the optional Agent dependency.
(defvar lispm-agents-show-function #'pop-to-buffer)
(defvar lispm-agents-roster-change-functions nil)

(defmacro lispm-office-inspect-test--with-agent (&rest body)
  "Run BODY with a live agent and mocked public LispM APIs."
  (declare (indent 0) (debug t))
  `(let* ((key '(lispm "session-a"))
          (pending (make-hash-table :test #'equal))
          (agent (list :name 'ada :turn 7 :pending pending :buffer nil :view nil))
          (source (generate-new-buffer " *Office test source*"))
          (lispm-agents-show-function #'pop-to-buffer)
          (live source) (approved nil) (denied nil) (sent nil) (stopped nil))
     (with-current-buffer source (setq-local lispm-session-agent agent))
     (setf (plist-get agent :buffer) source)
     (puthash "C1" (list :status 'ask :turn 7 :name "read-file" :input '(:path "/tmp/a")) pending)
     (unwind-protect
         (cl-letf (((get 'lispm-agent-pending 'compiler-macro) nil)
                   ((get 'lispm-agent-turn 'compiler-macro) nil)
                   ((get 'lispm-agent-name 'compiler-macro) nil)
                   ((get 'lispm-agent-character 'compiler-macro) nil)
                   ((get 'lispm-agent-model 'compiler-macro) nil)
                   ((get 'lispm-agent-view 'compiler-macro) nil)
                   ((get 'lispm-agent-buffer 'compiler-macro) nil)
                   ((symbol-function 'lispm-office-inspect--require) #'ignore)
                   ((symbol-function 'lispm-agents-roster-buffer) (lambda (identity) (and (equal identity key) live)))
                   ((symbol-function 'lispm-agent-turn) (lambda (a) (plist-get a :turn)))
                   ((symbol-function 'lispm-agent-name) (lambda (a) (plist-get a :name)))
                   ((symbol-function 'lispm-agent-pending) (lambda (a) (plist-get a :pending)))
                   ((symbol-function 'lispm-agent-character) (lambda (a) (plist-get a :character)))
                   ((symbol-function 'lispm-agent-model) (lambda (a) (plist-get a :model)))
                   ((symbol-function 'lispm-agent-view) (lambda (a) (plist-get a :view)))
                   ((symbol-function 'lispm-agent-buffer) (lambda (a) (plist-get a :buffer)))
                   ((symbol-function 'lispm-agents) (lambda () (list agent)))
                   ((symbol-function 'lispm-agents-show)
                    (lambda (buffer) (funcall lispm-agents-show-function buffer) buffer))
                   ((symbol-function 'lispm-agents-props) (lambda (_) nil))
                   ((symbol-function 'lispm-agents-buffer-status) (lambda (_) '(:state blocked :kind permission)))
                   ((symbol-function 'lispm-asked) (lambda (call) (or (plist-get call :asking) call)))
                   ((symbol-function 'lispm-waiting-calls)
                    (lambda (a) (let (ids)
                                  (maphash (lambda (id call) (when (eq (plist-get call :status) 'ask) (push id ids)))
                                           (plist-get a :pending))
                                  (sort ids #'string<))))
                   ((symbol-function 'lispm-approve-for) (lambda (a &optional id) (push (list a id) approved)))
                   ((symbol-function 'lispm-approve-all-for) (lambda (a) (push (list a 'all) approved)))
                   ((symbol-function 'lispm-deny-for) (lambda (a reason &optional id) (push (list a id reason) denied)))
                   ((symbol-function 'lispm-abort) (lambda (a) (setq stopped a)))
                   ((symbol-function 'lispm-tell) (lambda (&rest args) (setq sent args))))
           ,@body)
       (when (buffer-live-p source) (kill-buffer source)))))

(defmacro lispm-office-inspect-test--with-side-office (&rest body)
  "Run BODY with source and an Office side pane in real windows."
  (declare (indent 0) (debug t))
  `(lispm-office-inspect-test--with-agent
     (let ((owner (generate-new-buffer " *Office side owner*"))
           (lispm-office-inspect--buffers nil)
           (display-buffer-alist nil))
       (unwind-protect
           (save-window-excursion
             (delete-other-windows)
             (switch-to-buffer source)
             (let* ((source-window (selected-window))
                    (office-window (display-buffer-in-side-window
                                    owner '((side . right) (slot . 0)))))
               (cl-letf (((symbol-function 'lispm-agents-roster-details) (lambda (_) nil)))
                 ,@body)))
         (lispm-office-inspect-close owner)
         (kill-buffer owner)))))

(defmacro lispm-office-inspect-test--with-work-office (&rest body)
  "Run BODY with Office replacing the conversation in its main window."
  (declare (indent 0) (debug t))
  `(lispm-office-inspect-test--with-agent
     (let ((owner (generate-new-buffer " *Office Work owner*"))
           (lispm-office-inspect--buffers nil)
           (display-buffer-alist nil))
       (unwind-protect
           (save-window-excursion
             (delete-other-windows)
             (switch-to-buffer source)
             (let ((office-window (selected-window)))
               (set-window-buffer office-window owner)
               (cl-letf (((symbol-function 'lispm-agents-roster-details) (lambda (_) nil)))
                 ,@body)))
         (lispm-office-inspect-close owner)
         (kill-buffer owner)))))

(ert-deftest lispm-office-inspect-narrow-text-controls-wrap-and-support-keyboard ()
  (lispm-office-inspect-test--with-work-office
    (cl-letf (((symbol-function 'lispm-ui-tty-p) (lambda (&optional _) t))
              ((symbol-function 'lispm-office-inspect--available-width) (lambda () 35))
              ((symbol-function 'lispm-agents-roster-details) (lambda (_) '(:work (:turn 7)))))
      (with-current-buffer (lispm-office-inspect key 'work owner)
        (goto-char (point-min))
        (let (labels)
          (dotimes (_ 7)
            (call-interactively (key-binding (kbd "TAB")))
            (push (button-get (button-at (point)) 'lispm-ui-label) labels))
          (should (equal (nreverse labels)
                         '("Work" "Mailbox" "Character" "Open Chat" "Compose" "Approve All…" "Stop…"))))
        (call-interactively (key-binding (kbd "<backtab>")))
        (should (equal (button-get (button-at (point)) 'lispm-ui-label) "Approve All…"))
        ;; All control lines fit in 35 terminal columns, including controls
        ;; represented by one buffer character with a longer display string.
        (goto-char (point-min))
        (while (not (eobp))
          (let ((end (line-end-position)) (width 0) controls)
            (while (< (point) end)
              (when (get-text-property (point) 'lispm-ui-label) (setq controls t))
              (cl-incf width (let ((display (get-text-property (point) 'display)))
                               (if (stringp display) (string-width display) 1)))
              (forward-char))
            (when controls (should (<= width 35))))
          (forward-line))
        ;; The chat key uses the selected stable identity, with no prompting
        ;; or model request; the actual route has separate Focus coverage.
        (let (opened)
          (cl-letf (((symbol-function 'lispm-office-open-chat) (lambda (identity) (setq opened identity))))
            (call-interactively (key-binding (kbd "o")))
            (should (equal opened key))))))))

(ert-deftest lispm-office-inspect-native-tabs-use-pane-width-and-activate ()
  (with-temp-buffer
    (lispm-office-inspect-mode)
    (let (seen drawn)
      (cl-letf (((symbol-function 'lispm-ui-tty-p) (lambda (&optional _) nil))
                ((symbol-function 'lispm-office-inspect--available-width) (lambda () 210))
                ((symbol-function 'lispm-desktop-platinum-tabs)
                 (lambda (tabs width &optional _)
                   (setq seen (list (mapcar #'car tabs) width))
                   (mapconcat (lambda (tab) (apply #'propertize (car tab) (cddr tab))) tabs " ")))
                ((symbol-function 'lispm-office-inspect--draw) (lambda () (setq drawn t))))
        (let ((inhibit-read-only t)) (lispm-office-inspect--tabs))
        (should (equal seen '(("Work" "Mailbox" "Character") 210)))
        (goto-char (point-min))
        (search-forward "Character")
        (push-button (1- (point)))
        (should (eq lispm-office-inspect--tab 'character))
        (should drawn)))))

(ert-deftest lispm-office-inspect-first-render-and-resize-use-own-pane ()
  (lispm-office-inspect-test--with-work-office
    (cl-letf (((symbol-function 'lispm-ui-tty-p) (lambda (&optional _) t))
              ((symbol-function 'lispm-agents-roster-details) (lambda (_) '(:work (:turn 7)))))
      (let* ((inspector (lispm-office-inspect key 'work owner))
             (window (get-buffer-window inspector))
             (old-width (window-body-width window)))
        (should (= (buffer-local-value 'lispm-office-inspect--width inspector) (1- old-width)))
        (window-resize window -5 t)
        (should (/= (window-body-width window) old-width))
        (lispm-office-inspect-visible-refresh owner)
        (should (= (buffer-local-value 'lispm-office-inspect--width inspector)
                   (1- (window-body-width window))))))))

(ert-deftest lispm-office-inspect-partial-width-pane-wraps-text-and-reserves-edge ()
  (let ((truncate-partial-width-windows 50))
    (lispm-office-inspect-test--with-work-office
      (cl-letf (((symbol-function 'lispm-ui-tty-p) (lambda (&optional _) t)))
        (with-current-buffer (lispm-office-inspect key 'character owner)
          (let ((window (get-buffer-window (current-buffer))))
            (window-resize window (- 35 (window-body-width window)) t)
            (lispm-office-inspect-visible-refresh owner)
            (should (= (window-body-width window) 35))
            (should (= lispm-office-inspect--width 34))
            (should (local-variable-p 'truncate-partial-width-windows))
            (should-not truncate-partial-width-windows)
            (should-not truncate-lines)
            (should word-wrap)
            (goto-char (point-min))
            (search-forward "This conversation has no character identity.")
            (beginning-of-line)
            (let ((end (line-end-position)))
              (vertical-motion 1 window)
              (should (< (point) end)))
            ;; The action row formerly ended on the edge with Stop… clipped.
            ;; Inspect the actual display strings, including trailing gaps.
            (goto-char (point-min))
            (while (not (eobp))
              (let ((end (line-end-position)) (width 0) controls)
                (while (< (point) end)
                  (when (get-text-property (point) 'lispm-ui-label) (setq controls t))
                  (cl-incf width (let ((display (get-text-property (point) 'display)))
                                   (if (stringp display) (string-width display) 1)))
                  (forward-char))
                (when controls (should (< width 35))))
              (forward-line))))))))

(ert-deftest lispm-office-inspect-quit-restores-floor-keyboard-focus-after-resize ()
  (skip-unless (image-type-available-p 'svg))
  (lispm-office-inspect-test--with-work-office
    (let ((lispm-ui-current-palette
           (lispm-ui-derive-palette "#f4f2e9" "#24251f" "#77796d" "#6363ce"))
          (lispm-office-animate nil)
          inspected)
      (cl-letf (((symbol-function 'lispm-office--graphic-p) (lambda () t))
                ((symbol-function 'display-graphic-p) (lambda (&optional _) t))
                ((symbol-function 'lispm-office-inspect-selected)
                 (lambda (&optional _) (interactive) (setq inspected lispm-office--selected))))
        (with-current-buffer owner
          (lispm-office-mode)
          (setq lispm-office--demo t)
          (lispm-office--ingest
           (list (list :key key :name "Ada" :root temporary-file-directory :alive t
                       :status '(:state idle) :mailbox '(:queued 0)))))
        (let* ((inspector (lispm-office-inspect key 'work owner))
               (pane (get-buffer-window inspector)))
          (window-resize pane -5 t)
          (with-current-buffer owner
            (goto-char (point-min))
            (set-window-point office-window (point-min)))
          (with-current-buffer inspector (call-interactively (key-binding (kbd "q"))))
          (should-not (buffer-live-p inspector))
          (should (eq (selected-window) office-window))
          (with-current-buffer owner
            ;; The resize redraw after closing the pane keeps the floor focus.
            (lispm-office--draw)
            (should (= (point) lispm-office--floor-start))
            (should (eq (key-binding (kbd "RET")) #'lispm-office-inspect-selected))
            (call-interactively (key-binding (kbd "RET")))
            (should (equal inspected key))))))))

(ert-deftest lispm-office-inspect-preserves-work-window ()
  (lispm-office-inspect-test--with-work-office
    (let* ((inspector (lispm-office-inspect key 'work owner))
           (inspector-window (selected-window)))
      (should (eq (window-buffer office-window) owner))
      (should-not (window-parameter office-window 'window-side))
      (should (eq (window-parameter inspector-window 'window-side) 'right))
      (should (= (window-parameter inspector-window 'window-slot) 0))
      (should (= 2 (length (window-list nil 'nomini))))
      (with-current-buffer inspector (lispm-office-inspect-quit))
      (should-not (buffer-live-p inspector))
      (should-not (window-live-p inspector-window))
      (should (eq (window-buffer office-window) owner))
      (should (buffer-live-p source)))))

(ert-deftest lispm-office-inspect-close-removes-reused-placeholder-pane ()
  (lispm-office-inspect-test--with-work-office
    (let ((placeholder (generate-new-buffer " *Old buffer *LispM Office Inspector**")))
      (unwind-protect
          (let* ((stale-window (display-buffer-in-side-window
                                placeholder '((side . right) (slot . 0))))
                 (inspector (lispm-office-inspect key 'work owner))
                 (inspector-window (selected-window)))
            ;; Emacs remembers the old placeholder as quit-window's return
            ;; buffer when the Inspector reuses this slot.
            (should (eq inspector-window stale-window))
            (should (window-parameter inspector-window 'quit-restore))
            (lispm-office-inspect-close owner)
            (should-not (buffer-live-p inspector))
            (should-not (window-live-p inspector-window))
            (should (= 1 (length (window-list nil 'nomini))))
            (should (eq (window-buffer office-window) owner))
            (should (buffer-live-p source)))
        (when (buffer-live-p placeholder) (kill-buffer placeholder))))))

(ert-deftest lispm-office-inspect-killing-buffer-removes-its-owned-pane ()
  (lispm-office-inspect-test--with-work-office
    (let* ((inspector (lispm-office-inspect key 'work owner))
           (inspector-window (selected-window)))
      (should (equal (window-parameter inspector-window 'lispm-office-inspector)
                     (buffer-name inspector)))
      (kill-buffer inspector)
      (should-not (window-live-p inspector-window))
      (should-not lispm-office-inspect--buffers)
      (should (eq (window-buffer office-window) owner))
      (should (buffer-live-p source)))))

(ert-deftest lispm-office-inspect-close-preserves-a-repurposed-pane ()
  (lispm-office-inspect-test--with-work-office
    (let ((replacement (generate-new-buffer " *Unrelated pane contents*")))
      (unwind-protect
          (let* ((inspector (lispm-office-inspect key 'work owner))
                 (inspector-window (selected-window)))
            (with-current-buffer replacement (insert "Keep this user's buffer"))
            (set-window-dedicated-p inspector-window nil)
            (set-window-buffer inspector-window replacement)
            (lispm-office-inspect-close owner)
            (lispm-office-inspect-cleanup-windows)
            (should-not (buffer-live-p inspector))
            (should (window-live-p inspector-window))
            (should (eq (window-buffer inspector-window) replacement))
            (should-not (window-parameter inspector-window 'lispm-office-inspector))
            (should (equal (with-current-buffer replacement (buffer-string))
                           "Keep this user's buffer"))
            (should (eq (window-buffer office-window) owner)))
        (with-current-buffer replacement (set-buffer-modified-p nil))
        (kill-buffer replacement)))))

(ert-deftest lispm-office-inspect-close-preserves-last-ordinary-window ()
  (lispm-office-inspect-test--with-work-office
    (let ((inspector (lispm-office-inspect key 'work owner)))
      ;; A user can move the Inspector out of its side pane into the main window.
      (delete-window (selected-window))
      (set-window-buffer office-window inspector)
      (select-window office-window)
      (lispm-office-inspect-close owner)
      (should (window-live-p office-window))
      (should (eq (selected-window) office-window))
      (should (eq (window-buffer office-window) owner))
      (should (= 1 (length (window-list nil 'nomini))))
      (should-not (buffer-live-p inspector)))))

(ert-deftest lispm-office-inspect-restored-tab-removes-only-dead-inspector ()
  (lispm-office-inspect-test--with-work-office
    (let* ((saved-tabs (copy-tree (frame-parameter nil 'tabs)))
           (source-tab (1+ (tab-bar--current-tab-index)))
           (tab-bar-new-tab-to 'right)
           (tab-bar-new-tab-choice "*scratch*")
           (window-state-change-functions nil)
           placeholder restored-marker target-tab
           (tab-bar-tab-post-select-functions
            (list (lambda (&rest _)
                    (dolist (window (window-list nil 'nomini))
                      (when (lispm-office-inspect--placeholder-p (window-buffer window))
                        (setq placeholder (window-buffer window)
                              restored-marker
                              (window-parameter window 'lispm-office-inspector)))))
                  #'lispm-office-inspect-cleanup-windows))
           (inspector (lispm-office-inspect key 'work owner)))
      (unwind-protect
          (progn
            (tab-bar-new-tab)
            (setq target-tab (1+ (tab-bar--current-tab-index)))
            ;; Closing from another workspace leaves an inactive configuration
            ;; referring to the Inspector that no longer exists.
            (lispm-office-inspect-close owner)
            (should-not (buffer-live-p inspector))
            (tab-bar-select-tab source-tab)
            (should placeholder)
            (should (stringp restored-marker))
            (should (= 1 (length (window-list nil 'nomini))))
            (should (eq (window-buffer (selected-window)) owner))
            (should-not (buffer-live-p placeholder))
            (should (buffer-live-p source))
            (tab-bar-close-tab target-tab source-tab)
            (setq target-tab nil))
        (when target-tab (tab-bar-close-tab target-tab))
        (set-frame-parameter nil 'tabs saved-tabs)
        (when (buffer-live-p placeholder) (kill-buffer placeholder))))))

(ert-deftest lispm-office-inspect-cleans-legacy-notice-but-keeps-unrelated-notices ()
  (lispm-office-inspect-test--with-work-office
    (let ((legacy-window (display-buffer-in-side-window
                          (get-buffer-create " *Legacy inspector slot*")
                          '((side . right) (slot . 0))))
          (unrelated-window (display-buffer-in-side-window
                             (get-buffer-create " *Unrelated old slot*")
                             '((side . right) (slot . 1))))
          legacy-notice unrelated-notice)
      (unwind-protect
          (progn
            (tab-bar-select-restore-windows
             nil (list (list legacy-window "*LispM Office Inspector*" 1 1)
                       (list unrelated-window "*Unrelated utility*" 1 1)) nil)
            (setq legacy-notice (window-buffer legacy-window)
                  unrelated-notice (window-buffer unrelated-window))
            (should-not (window-parameter legacy-window 'lispm-office-inspector))
            (run-hook-with-args 'tab-bar-tab-post-select-functions nil nil)
            (should-not (window-live-p legacy-window))
            (should-not (buffer-live-p legacy-notice))
            (should (window-live-p unrelated-window))
            (should (eq (window-buffer unrelated-window) unrelated-notice))
            (should (eq (window-buffer office-window) owner)))
        (dolist (buffer (list legacy-notice unrelated-notice
                              (get-buffer " *Legacy inspector slot*")
                              (get-buffer " *Unrelated old slot*")))
          (when (buffer-live-p buffer) (kill-buffer buffer)))))))

(ert-deftest lispm-office-open-chat-returns-native-view-to-owner-work-window ()
  (lispm-office-inspect-test--with-work-office
    (let ((chat (generate-new-buffer " *Office returning chat*")))
      (unwind-protect
          (progn
            (setf (plist-get agent :view) chat)
            (let ((other-window (split-window office-window nil 'below)))
              ;; An existing view elsewhere must not leave the Work window behind.
              (set-window-buffer other-window chat)
              (let ((inspector (lispm-office-inspect key 'work owner)))
                (cl-letf (((symbol-function 'lispm-switch)
                           (lambda (_) (ert-fail "Existing native view must be reused"))))
                  (lispm-office-open-chat key))
                (should (eq (selected-window) office-window))
                (should (eq (window-buffer office-window) chat))
                (should (eq (window-buffer other-window) chat))
                (should-not (get-buffer-window owner))
                (should (buffer-live-p owner))
                (should (get-buffer-window inspector))
                (should (buffer-live-p source)))))
        (kill-buffer chat)))))

(ert-deftest lispm-office-open-chat-from-work-reuses-its-window ()
  (lispm-office-inspect-test--with-work-office
    (with-current-buffer owner
      (setq key '(claude "session-a"))
      (with-current-buffer source (setq-local lispm-session-agent nil))
      (lispm-office-open-chat key))
    (should (eq (selected-window) office-window))
    (should (eq (window-buffer office-window) source))
    (should (= 1 (length (window-list nil 'nomini))))))

(ert-deftest lispm-office-open-chat-honors-native-and-terminal-host-routing ()
  (dolist (kind '(native new-native terminal))
    (lispm-office-inspect-test--with-work-office
      (let ((chat (generate-new-buffer " *Office host target*")))
        (unwind-protect
            (let* ((host-window (split-window office-window nil 'below))
                   (target (if (eq kind 'terminal) source chat))
                   (display-buffer-overriding-action '(display-buffer-no-window))
                   (incoming-action display-buffer-overriding-action)
                   host-called host-action
                   (lispm-agents-show-function
                    (lambda (buffer)
                      (setq host-called buffer host-action display-buffer-overriding-action)
                      (set-window-buffer host-window buffer)
                      (select-window host-window))))
              (pcase kind
                ('native (setf (plist-get agent :view) chat))
                ('terminal
                 (setq key '(claude "session-a"))
                 (with-current-buffer source (setq-local lispm-session-agent nil))))
              (lispm-office-inspect key 'work owner)
              (cl-letf (((symbol-function 'lispm-agent-display-buffer) (lambda (_) chat)))
                (lispm-office-open-chat key))
              (should (eq host-called target))
              (should (eq host-action incoming-action))
              (should (eq (selected-window) host-window))
              (should (eq (current-buffer) target))
              (should (eq (window-buffer office-window) owner)))
          (kill-buffer chat))))))

(ert-deftest lispm-office-open-chat-closes-hidden-work-and-owned-resources ()
  (dolist (custom '(nil t))
    (lispm-office-inspect-test--with-work-office
      (let ((chat (generate-new-buffer " *Office cleanup chat*"))
            (lispm-office--buffers nil)
            (lispm-agents-roster-change-functions nil)
            (window-size-change-functions nil)
            (window-state-change-functions nil)
            (lispm-ui-palette-changed-hook nil))
        (unwind-protect
            (progn
              (setf (plist-get agent :view) chat)
              (with-current-buffer owner
                (lispm-office-mode)
                (lispm-office--observe))
              (let* ((point (with-current-buffer source (copy-marker (point-min))))
                     (start (copy-marker point))
                     (inspector (lispm-office-inspect key 'work owner))
                     host-called
                     (lispm-agents-show-function
                      (if custom
                          (lambda (buffer)
                            (setq host-called buffer)
                            (set-window-buffer office-window buffer)
                            (select-window office-window))
                        #'pop-to-buffer)))
                (set-window-parameter office-window 'lispm-office-source
                                      (list :view owner :buffer source :point point :start start
                                            :hscroll 0 :vscroll 0))
                (should lispm-agents-roster-change-functions)
                (lispm-office-open-chat key)
                (when custom (should (eq host-called chat)))
                (should-not (buffer-live-p owner))
                (should-not (buffer-live-p inspector))
                (should-not lispm-office--buffers)
                (should-not lispm-office-inspect--buffers)
                (should-not lispm-agents-roster-change-functions)
                (should-not window-size-change-functions)
                (should-not window-state-change-functions)
                (should-not lispm-ui-palette-changed-hook)
                (should-not (window-parameter office-window 'lispm-office-source))
                (should-not (marker-buffer point))
                (should-not (marker-buffer start))
                (should (eq (selected-window) office-window))
                (should (eq (current-buffer) chat))
                (should (eq (window-buffer office-window) chat))
                (should (buffer-live-p source))
                (should (= 1 (length (window-list nil 'nomini))))))
          (kill-buffer chat))))))

(ert-deftest lispm-office-open-chat-restores-old-tab-before-host-navigation ()
  (lispm-office-inspect-test--with-work-office
    (let ((chat (generate-new-buffer " *Office other-project chat*"))
          (lispm-office--buffers nil)
          (lispm-agents-roster-change-functions nil)
          (window-size-change-functions nil)
          (window-state-change-functions nil)
          (lispm-ui-palette-changed-hook nil)
          (tab-bar-new-tab-to 'right)
          (tab-bar-new-tab-choice "*scratch*")
          (saved-tabs (copy-tree (frame-parameter nil 'tabs)))
          target-tab)
      (unwind-protect
          (progn
            (setf (plist-get agent :view) chat)
            (with-current-buffer owner
              (lispm-office-mode)
              (lispm-office--observe))
            (let* ((source-tab (1+ (tab-bar--current-tab-index)))
                   (point (with-current-buffer source (copy-marker (point-min))))
                   (start (copy-marker point))
                   (inspector (lispm-office-inspect key 'work owner))
                   (lispm-agents-show-function
                    (lambda (buffer)
                      (tab-bar-new-tab)
                      (setq target-tab (1+ (tab-bar--current-tab-index)))
                      (switch-to-buffer buffer))))
              (set-window-parameter office-window 'lispm-office-source
                                    (list :view owner :buffer source :point point :start start
                                          :hscroll 0 :vscroll 0))
              (lispm-office-open-chat key)
              (should (= (1+ (tab-bar--current-tab-index)) target-tab))
              (should (eq (current-buffer) chat))
              (should (eq (window-buffer (selected-window)) chat))
              (should-not (buffer-live-p owner))
              (should-not (buffer-live-p inspector))
              (should-not lispm-office--buffers)
              (should-not lispm-office-inspect--buffers)
              (should-not lispm-agents-roster-change-functions)
              (should-not (marker-buffer point))
              (should-not (marker-buffer start))
              (tab-bar-select-tab source-tab)
              (should (eq (current-buffer) source))
              (should (eq (window-buffer (selected-window)) source))
              (should (= 1 (length (window-list nil 'nomini))))
              (should-not (window-parameter (selected-window) 'lispm-office-source))
              (tab-bar-close-tab target-tab source-tab)
              (setq target-tab nil)))
        (when target-tab (tab-bar-close-tab target-tab))
        (set-frame-parameter nil 'tabs saved-tabs)
        (kill-buffer chat)))))

