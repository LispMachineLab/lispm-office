;;; lispm-office-inspect-test.el --- Inspector and action tests -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'lispm-office-inspect)
(require 'lispm-office)

;; Public host variables normally bound by the optional Agent dependency.
(defvar lispm-agents-show-function #'pop-to-buffer)
(defvar lispm-agents-roster-change-functions nil)

(defmacro lispm-office-inspect-test--with-agent (&rest body)
  "Run BODY with a live agent and mocked public LispM APIs."
  (declare (indent 0) (debug t))
  `(let* ((key '(lispm "session-a"))
          (pending (make-hash-table :test #'equal))
          (agent (list :name 'ada :turn 7 :pending pending :buffer nil :view nil))
          (source (generate-new-buffer " *Office test source*"))
          (lispm-agents-show-function #'pop-to-buffer)
          (live source) (approved nil) (denied nil) (sent nil) (stopped nil))
     (with-current-buffer source (setq-local lispm-session-agent agent))
     (setf (plist-get agent :buffer) source)
     (puthash "C1" (list :status 'ask :turn 7 :name "read-file" :input '(:path "/tmp/a")) pending)
     (unwind-protect
         (cl-letf (((get 'lispm-agent-pending 'compiler-macro) nil)
                   ((get 'lispm-agent-turn 'compiler-macro) nil)
                   ((get 'lispm-agent-name 'compiler-macro) nil)
                   ((get 'lispm-agent-character 'compiler-macro) nil)
                   ((get 'lispm-agent-model 'compiler-macro) nil)
                   ((get 'lispm-agent-view 'compiler-macro) nil)
                   ((get 'lispm-agent-buffer 'compiler-macro) nil)
                   ((symbol-function 'lispm-office-inspect--require) #'ignore)
                   ((symbol-function 'lispm-agents-roster-buffer) (lambda (identity) (and (equal identity key) live)))
                   ((symbol-function 'lispm-agent-turn) (lambda (a) (plist-get a :turn)))
                   ((symbol-function 'lispm-agent-name) (lambda (a) (plist-get a :name)))
                   ((symbol-function 'lispm-agent-pending) (lambda (a) (plist-get a :pending)))
                   ((symbol-function 'lispm-agent-character) (lambda (a) (plist-get a :character)))
                   ((symbol-function 'lispm-agent-model) (lambda (a) (plist-get a :model)))
                   ((symbol-function 'lispm-agent-view) (lambda (a) (plist-get a :view)))
                   ((symbol-function 'lispm-agent-buffer) (lambda (a) (plist-get a :buffer)))
                   ((symbol-function 'lispm-agents) (lambda () (list agent)))
                   ((symbol-function 'lispm-agents-show)
                    (lambda (buffer) (funcall lispm-agents-show-function buffer) buffer))
                   ((symbol-function 'lispm-agents-props) (lambda (_) nil))
                   ((symbol-function 'lispm-agents-buffer-status) (lambda (_) '(:state blocked :kind permission)))
                   ((symbol-function 'lispm-asked) (lambda (call) (or (plist-get call :asking) call)))
                   ((symbol-function 'lispm-waiting-calls)
                    (lambda (a) (let (ids)
                                  (maphash (lambda (id call) (when (eq (plist-get call :status) 'ask) (push id ids)))
                                           (plist-get a :pending))
                                  (sort ids #'string<))))
                   ((symbol-function 'lispm-approve-for) (lambda (a &optional id) (push (list a id) approved)))
                   ((symbol-function 'lispm-approve-all-for) (lambda (a) (push (list a 'all) approved)))
                   ((symbol-function 'lispm-deny-for) (lambda (a reason &optional id) (push (list a id reason) denied)))
                   ((symbol-function 'lispm-abort) (lambda (a) (setq stopped a)))
                   ((symbol-function 'lispm-tell) (lambda (&rest args) (setq sent args))))
           ,@body)
       (when (buffer-live-p source) (kill-buffer source)))))

(defmacro lispm-office-inspect-test--with-side-office (&rest body)
  "Run BODY with source and an Office side pane in real windows."
  (declare (indent 0) (debug t))
  `(lispm-office-inspect-test--with-agent
     (let ((owner (generate-new-buffer " *Office side owner*"))
           (lispm-office-inspect--buffers nil)
           (display-buffer-alist nil))
       (unwind-protect
           (save-window-excursion
             (delete-other-windows)
             (switch-to-buffer source)
             (let* ((source-window (selected-window))
                    (office-window (display-buffer-in-side-window
                                    owner '((side . right) (slot . 0)))))
               (cl-letf (((symbol-function 'lispm-agents-roster-details) (lambda (_) nil)))
                 ,@body)))
         (lispm-office-inspect-close owner)
         (kill-buffer owner)))))

(defmacro lispm-office-inspect-test--with-work-office (&rest body)
  "Run BODY with Office replacing the conversation in its main window."
  (declare (indent 0) (debug t))
  `(lispm-office-inspect-test--with-agent
     (let ((owner (generate-new-buffer " *Office Work owner*"))
           (lispm-office-inspect--buffers nil)
           (display-buffer-alist nil))
       (unwind-protect
           (save-window-excursion
             (delete-other-windows)
             (switch-to-buffer source)
             (let ((office-window (selected-window)))
               (set-window-buffer office-window owner)
               (cl-letf (((symbol-function 'lispm-agents-roster-details) (lambda (_) nil)))
                 ,@body)))
         (lispm-office-inspect-close owner)
         (kill-buffer owner)))))

(ert-deftest lispm-office-inspect-preserves-work-window ()
  (lispm-office-inspect-test--with-work-office
    (let* ((inspector (lispm-office-inspect key 'work owner))
           (inspector-window (selected-window)))
      (should (eq (window-buffer office-window) owner))
      (should-not (window-parameter office-window 'window-side))
      (should (eq (window-parameter inspector-window 'window-side) 'right))
      (should (= (window-parameter inspector-window 'window-slot) 0))
      (should (= 2 (length (window-list nil 'nomini))))
      (with-current-buffer inspector (lispm-office-inspect-quit))
      (should-not (buffer-live-p inspector))
      (should-not (window-live-p inspector-window))
      (should (eq (window-buffer office-window) owner))
      (should (buffer-live-p source)))))

(ert-deftest lispm-office-open-chat-returns-native-view-to-owner-work-window ()
  (lispm-office-inspect-test--with-work-office
    (let ((chat (generate-new-buffer " *Office returning chat*")))
      (unwind-protect
          (progn
            (setf (plist-get agent :view) chat)
            (let ((other-window (split-window office-window nil 'below)))
              ;; An existing view elsewhere must not leave the Work window behind.
              (set-window-buffer other-window chat)
              (let ((inspector (lispm-office-inspect key 'work owner)))
                (cl-letf (((symbol-function 'lispm-switch)
                           (lambda (_) (ert-fail "Existing native view must be reused"))))
                  (lispm-office-open-chat key))
                (should (eq (selected-window) office-window))
                (should (eq (window-buffer office-window) chat))
                (should (eq (window-buffer other-window) chat))
                (should-not (get-buffer-window owner))
                (should (buffer-live-p owner))
                (should (get-buffer-window inspector))
                (should (buffer-live-p source)))))
        (kill-buffer chat)))))

(ert-deftest lispm-office-open-chat-from-work-reuses-its-window ()
  (lispm-office-inspect-test--with-work-office
    (with-current-buffer owner
      (setq key '(claude "session-a"))
      (with-current-buffer source (setq-local lispm-session-agent nil))
      (lispm-office-open-chat key))
    (should (eq (selected-window) office-window))
    (should (eq (window-buffer office-window) source))
    (should (= 1 (length (window-list nil 'nomini))))))

(ert-deftest lispm-office-open-chat-honors-native-and-terminal-host-routing ()
  (dolist (kind '(native new-native terminal))
    (lispm-office-inspect-test--with-work-office
      (let ((chat (generate-new-buffer " *Office host target*")))
        (unwind-protect
            (let* ((host-window (split-window office-window nil 'below))
                   (target (if (eq kind 'terminal) source chat))
                   (display-buffer-overriding-action '(display-buffer-no-window))
                   (incoming-action display-buffer-overriding-action)
                   host-called host-action
                   (lispm-agents-show-function
                    (lambda (buffer)
                      (setq host-called buffer host-action display-buffer-overriding-action)
                      (set-window-buffer host-window buffer)
                      (select-window host-window))))
              (pcase kind
                ('native (setf (plist-get agent :view) chat))
                ('terminal
                 (setq key '(claude "session-a"))
                 (with-current-buffer source (setq-local lispm-session-agent nil))))
              (lispm-office-inspect key 'work owner)
              (cl-letf (((symbol-function 'lispm-agent-display-buffer) (lambda (_) chat)))
                (lispm-office-open-chat key))
              (should (eq host-called target))
              (should (eq host-action incoming-action))
              (should (eq (selected-window) host-window))
              (should (eq (current-buffer) target))
              (should (eq (window-buffer office-window) owner)))
          (kill-buffer chat))))))

(ert-deftest lispm-office-open-chat-closes-hidden-work-and-owned-resources ()
  (dolist (custom '(nil t))
    (lispm-office-inspect-test--with-work-office
      (let ((chat (generate-new-buffer " *Office cleanup chat*"))
            (lispm-office--buffers nil)
            (lispm-agents-roster-change-functions nil)
            (window-size-change-functions nil)
            (window-state-change-functions nil)
            (lispm-ui-palette-changed-hook nil))
        (unwind-protect
            (progn
              (setf (plist-get agent :view) chat)
              (with-current-buffer owner
                (lispm-office-mode)
                (lispm-office--observe))
              (let* ((point (with-current-buffer source (copy-marker (point-min))))
                     (start (copy-marker point))
                     (inspector (lispm-office-inspect key 'work owner))
                     host-called
                     (lispm-agents-show-function
                      (if custom
                          (lambda (buffer)
                            (setq host-called buffer)
                            (set-window-buffer office-window buffer)
                            (select-window office-window))
                        #'pop-to-buffer)))
                (set-window-parameter office-window 'lispm-office-source
                                      (list :view owner :buffer source :point point :start start
                                            :hscroll 0 :vscroll 0))
                (should lispm-agents-roster-change-functions)
                (lispm-office-open-chat key)
                (when custom (should (eq host-called chat)))
                (should-not (buffer-live-p owner))
                (should-not (buffer-live-p inspector))
                (should-not lispm-office--buffers)
                (should-not lispm-office-inspect--buffers)
                (should-not lispm-agents-roster-change-functions)
                (should-not window-size-change-functions)
                (should-not window-state-change-functions)
                (should-not lispm-ui-palette-changed-hook)
                (should-not (window-parameter office-window 'lispm-office-source))
                (should-not (marker-buffer point))
                (should-not (marker-buffer start))
                (should (eq (selected-window) office-window))
                (should (eq (current-buffer) chat))
                (should (eq (window-buffer office-window) chat))
                (should (buffer-live-p source))
                (should (= 1 (length (window-list nil 'nomini))))))
          (kill-buffer chat))))))

(ert-deftest lispm-office-open-chat-restores-old-tab-before-host-navigation ()
  (lispm-office-inspect-test--with-work-office
    (let ((chat (generate-new-buffer " *Office other-project chat*"))
          (lispm-office--buffers nil)
          (lispm-agents-roster-change-functions nil)
          (window-size-change-functions nil)
          (window-state-change-functions nil)
          (lispm-ui-palette-changed-hook nil)
          (tab-bar-new-tab-to 'right)
          (tab-bar-new-tab-choice "*scratch*")
          (saved-tabs (copy-tree (frame-parameter nil 'tabs)))
          target-tab)
      (unwind-protect
          (progn
            (setf (plist-get agent :view) chat)
            (with-current-buffer owner
              (lispm-office-mode)
              (lispm-office--observe))
            (let* ((source-tab (1+ (tab-bar--current-tab-index)))
                   (point (with-current-buffer source (copy-marker (point-min))))
                   (start (copy-marker point))
                   (inspector (lispm-office-inspect key 'work owner))
                   (lispm-agents-show-function
                    (lambda (buffer)
                      (tab-bar-new-tab)
                      (setq target-tab (1+ (tab-bar--current-tab-index)))
                      (switch-to-buffer buffer))))
              (set-window-parameter office-window 'lispm-office-source
                                    (list :view owner :buffer source :point point :start start
                                          :hscroll 0 :vscroll 0))
              (lispm-office-open-chat key)
              (should (= (1+ (tab-bar--current-tab-index)) target-tab))
              (should (eq (current-buffer) chat))
              (should (eq (window-buffer (selected-window)) chat))
              (should-not (buffer-live-p owner))
              (should-not (buffer-live-p inspector))
              (should-not lispm-office--buffers)
              (should-not lispm-office-inspect--buffers)
              (should-not lispm-agents-roster-change-functions)
              (should-not (marker-buffer point))
              (should-not (marker-buffer start))
              (tab-bar-select-tab source-tab)
              (should (eq (current-buffer) source))
              (should (eq (window-buffer (selected-window)) source))
              (should (= 1 (length (window-list nil 'nomini))))
              (should-not (window-parameter (selected-window) 'lispm-office-source))
              (tab-bar-close-tab target-tab source-tab)
              (setq target-tab nil)))
        (when target-tab (tab-bar-close-tab target-tab))
        (set-frame-parameter nil 'tabs saved-tabs)
        (kill-buffer chat)))))

(ert-deftest lispm-office-inspect-initializes-palette-before-controls ()
