(ert-deftest lispm-office-inspect-follow-keeps-tab-and-focus-without-creating ()
  (lispm-office-inspect-test--with-side-office
    (lispm-office-inspect-follow owner key)
    (should-not lispm-office-inspect--buffers)
    (let* ((inspector (lispm-office-inspect key 'mailbox owner))
           (draws 0) (visible t))
      (select-window source-window)
      (cl-letf (((symbol-function 'lispm-office-inspect--visible-p) (lambda () visible))
                ((symbol-function 'lispm-office-inspect--draw)
                 (lambda () (cl-incf draws) (setq lispm-office-inspect--dirty nil))))
        (setq key '(lispm "session-b"))
        (lispm-office-inspect-follow owner key)
        (should (= draws 1))
        (should (equal (buffer-local-value 'lispm-office-inspect--key inspector) key))
        (should (eq (buffer-local-value 'lispm-office-inspect--tab inspector) 'mailbox))
        (should (eq (selected-window) source-window))
        (lispm-office-inspect-follow owner key)
        (should (= draws 1))
        (setq visible nil key '(lispm "session-c"))
        (lispm-office-inspect-follow owner key)
        (should (= draws 1))
        (should (buffer-local-value 'lispm-office-inspect--dirty inspector))
        (should (eq (selected-window) source-window))
        (setq visible t)
        (lispm-office-inspect-visible-refresh owner)
        (should (= draws 2))))))

