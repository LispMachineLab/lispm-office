                 (lambda ()
                   (cl-incf initializations)
                   (setq lispm-ui-current-palette '(:fixture t))))
                ((symbol-function 'lispm-ui-insert-push-button)
                 (lambda (&rest _) (push lispm-ui-current-palette control-palettes))))
        (with-temp-buffer
          (lispm-office-inspect-mode)
          (setq lispm-office-inspect--key key lispm-office-inspect--tab 'character)
          (lispm-office-inspect--draw)
          (lispm-office-inspect--draw)))
      (should (= initializations 1))
      (should control-palettes)
      (should (seq-every-p (lambda (palette) (equal palette '(:fixture t))) control-palettes)))))

